diff --git a/tests/gateway/test_ack_silence.py b/tests/gateway/test_ack_silence.py
new file mode 100644
index 0000000000000000000000000000000000000000..79a62df96aff207534a6f4cd0becc219b7440668
--- /dev/null
+++ b/tests/gateway/test_ack_silence.py
@@ -0,0 +1,55 @@
+"""A bare acknowledgement may end quietly, and the silence notice wording is a profile setting.
+
+Both are off unless the profile's display config turns them on. Made-up text only.
+"""
+import json
+
+import pytest
+
+from gateway import response_filters as rf
+from gateway.response_filters import is_pure_acknowledgement, silence_allowed
+
+
+@pytest.mark.parametrize("text", ["Got it", "got it.", "OK", "ok thanks!", "Thanks", "👍", "sounds good", "  Perfect  "])
+def test_acks(text):
+    assert is_pure_acknowledgement(text)
+
+
+@pytest.mark.parametrize("text", ["You still alive?", "1 yes  their name is Alex. ", "got it, now send it to Jordan",
+                                  "ok?", "", None, "thanks for the draft, change the second line"])
+def test_not_acks(text):
+    assert not is_pure_acknowledgement(text)
+
+
+def test_ack_turn_allows_silence():
+    assert silence_allowed(None, False)
+    assert not silence_allowed(None, None)
+
+
+def _profile(tmp_path, monkeypatch, display):
+    home = tmp_path / "home"
+    home.mkdir(exist_ok=True)
+    (home / "config.yaml").write_text(json.dumps({"display": display}))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+
+def test_settings_are_off_by_default(tmp_path, monkeypatch):
+    _profile(tmp_path, monkeypatch, {})
+    assert rf.quiet_acknowledgements_enabled() is False
+    assert rf.unexpected_silence_notice() is None
+    from gateway.run_turn import _unexpected_silence_reply
+    assert "silence marker" in _unexpected_silence_reply()
+
+
+def test_profile_opts_in(tmp_path, monkeypatch):
+    _profile(tmp_path, monkeypatch, {"quiet_acknowledgements": True,
+                                     "unexpected_silence_notice": "Sorry, that reply got lost. Send it again?"})
+    assert rf.quiet_acknowledgements_enabled() is True
+    from gateway.run_turn import _unexpected_silence_reply
+    assert _unexpected_silence_reply() == "Sorry, that reply got lost. Send it again?"
+
+
+@pytest.mark.parametrize("value", [True, "yes", 1])
+def test_only_a_real_true_turns_it_on(tmp_path, monkeypatch, value):
+    _profile(tmp_path, monkeypatch, {"quiet_acknowledgements": value})
+    assert rf.quiet_acknowledgements_enabled() is (value is True)
