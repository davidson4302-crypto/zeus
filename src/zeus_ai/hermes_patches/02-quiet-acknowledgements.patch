+# A bare acknowledgement closes the exchange, so an agent's silence marker on it is correct, not an
+# error to report.
+_ACK_PHRASES = frozenset({
+    "got it", "gotcha", "ok", "okay", "k", "kk", "ok thanks", "okay thanks", "ok thank you",
+    "thanks", "thank you", "thx", "ty", "tysm", "thanks!", "cool", "cool thanks", "nice", "perfect",
+    "great", "great thanks", "sounds good", "sounds great", "all good", "will do", "noted", "roger",
+    "copy", "copy that", "understood", "makes sense", "awesome", "sweet", "got it thanks",
+    "got it thank you", "perfect thanks", "ok cool", "ok great", "ok perfect", "word", "bet",
+    "👍", "👌", "🙏", "✅", "🙌", "👍🏻", "👍🏼", "👍🏽", "👍🏾", "👍🏿", "❤️", "😊", "🔥",
+})
+
+
+def _display_setting(key: str) -> Any:
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        return (load_config_readonly().get("display") or {}).get(key)
+    except Exception:
+        return None
+
+
+def quiet_acknowledgements_enabled() -> bool:
+    """``display.quiet_acknowledgements`` in the active profile's config (off by default)."""
+    return _display_setting("quiet_acknowledgements") is True
+
+
+def unexpected_silence_notice() -> Optional[str]:
+    """``display.unexpected_silence_notice``: the profile's own wording for that notice, or None."""
+    value = _display_setting("unexpected_silence_notice")
+    return value.strip()[:500] if isinstance(value, str) and value.strip() else None
+
+
+def is_pure_acknowledgement(text: Any) -> bool:
+    """True when ``text`` is only a short closing acknowledgement ("Got it", "ok thanks", "👍")."""
+    if not isinstance(text, str):
+        return False
+    t = " ".join(text.strip().lower().split())
+    if not t or len(t) > 40:
+        return False
+    t = t.strip(" .!,~")
+    return t in _ACK_PHRASES
+
+
 def reply_expected_metadata(reply_expected: Optional[bool]) -> dict:
     """The persisted user row's ``reply_expected`` key, only when the adapter knew; crash recovery
     reads it back to judge a silence marker as the live turn did."""
