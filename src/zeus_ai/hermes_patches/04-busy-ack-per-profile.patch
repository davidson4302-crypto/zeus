 logger = logging.getLogger("gateway.run")
 
 
+def busy_ack_enabled_for_source(runner: Any, source: SessionSource) -> bool:
+    """Resolve chatter policy from the admitted event's runtime profile, not the host bridge."""
+    from gateway.run import _load_gateway_config, _platform_config_key
+    from gateway.display_config import resolve_display_setting
+
+    fallback = os.environ.get("HERMES_GATEWAY_BUSY_ACK_ENABLED", "true").lower() == "true"
+    resolve_home = getattr(runner, "_resolve_profile_home_for_source", None)
+    if not callable(resolve_home):
+        return fallback  # Older/small dispatch hosts retain the existing environment contract.
+    try:
+        config = _load_gateway_config(resolve_home(source) / "config.yaml")
+        return bool(resolve_display_setting(
+            config, _platform_config_key(source.platform), "busy_ack_enabled", fallback,
+        ))
+    except Exception:
+        # An unresolved source never borrows another profile's display policy; it keeps the
+        # gateway-wide environment setting that applied before per-profile settings existed.
+        logger.debug("Busy acknowledgement profile resolution failed; using the gateway default", exc_info=True)
+        return fallback
+
