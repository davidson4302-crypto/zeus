diff --git a/tests/gateway/test_busy_ack_profile_settings.py b/tests/gateway/test_busy_ack_profile_settings.py
new file mode 100644
index 0000000000000000000000000000000000000000..f590edc3c913853a5f07edb2f98df428ff9b1e67
--- /dev/null
+++ b/tests/gateway/test_busy_ack_profile_settings.py
@@ -0,0 +1,114 @@
+"""Busy acknowledgements follow the admitted runtime profile; queueing remains intact."""
+import asyncio
+import json
+from pathlib import Path
+from types import MethodType
+
+import pytest
+
+from gateway.config import Platform
+from gateway.run import GatewayRunner
+from gateway.run_busy import busy_ack_enabled_for_source
+from gateway.session import SessionSource
+from gateway.shared_conversation_dispatch import shared_queue_size
+from tests.gateway.test_shared_conversation_dispatch import setup, event, idle, KEY
+from tests.gateway.test_shared_conversation_busy_steer import _busy, _dm, _until
+
+
+@pytest.fixture
+def profile_homes(tmp_path, monkeypatch):
+    root = tmp_path / ".hermes"
+    root.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    monkeypatch.setenv("HERMES_GATEWAY_BUSY_ACK_ENABLED", "true")
+    for name, display in [("quiet", {"busy_ack_enabled": False}), ("ordinary", {})]:
+        home = root / "profiles" / name
+        home.mkdir(parents=True)
+        (home / "config.yaml").write_text(json.dumps({"display": display}))
+    return root
+
+
+def bind_native_resolver(runner):
+    runner._resolve_profile_home_for_source = MethodType(
+        GatewayRunner._resolve_profile_home_for_source, runner)
+
+
+def test_real_profile_config_quiet_setting_does_not_leak_a_to_b_to_a(profile_homes):
+    runner = object.__new__(GatewayRunner)
+    for name, expected in [("quiet", False), ("ordinary", True), ("quiet", False)]:
+        source = SessionSource(Platform.SIGNAL, "owner-chat", user_id="owner", profile=name)
+        assert busy_ack_enabled_for_source(runner, source) is expected
+
+
+def test_explicit_platform_setting_wins_and_unconfigured_keeps_legacy_env(profile_homes, monkeypatch):
+    monkeypatch.setenv("HERMES_GATEWAY_BUSY_ACK_ENABLED", "false")
+    runner = object.__new__(GatewayRunner)
+    source = SessionSource(Platform.SIGNAL, "owner-chat", user_id="owner", profile="ordinary")
+    assert busy_ack_enabled_for_source(runner, source) is False
+    (profile_homes / "profiles/ordinary/config.yaml").write_text(json.dumps({"display": {
+        "busy_ack_enabled": "false", "platforms": {"signal": {"busy_ack_enabled": "true"}}}}))
+    assert busy_ack_enabled_for_source(runner, source) is True
+    source.platform = Platform.SLACK
+    assert busy_ack_enabled_for_source(runner, source) is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("profile,ack_count", [("quiet", 0), ("ordinary", 1)])
+async def test_shared_fifo_retains_input_and_final_reply_with_scoped_ack_policy(
+        profile_homes, monkeypatch, profile, ack_count):
+    from unittest.mock import AsyncMock
+    runner, (slack, photon), intake, observed = setup(monkeypatch)
+    bind_native_resolver(runner)
+    runner._send_busy_ack_reply = AsyncMock()
+    started, release = asyncio.Event(), asyncio.Event()
+    order = []
+
+    async def handler(e):
+        order.append(e.message_id)
+        e._gateway_deferred = False
+        if e.message_id == "first":
+            started.set()
+            await release.wait()
+        return "final:" + e.message_id
+
+    slack._message_handler = photon._message_handler = handler
+    first, queued = event(slack, "first input", "first"), event(photon, "keep this input", "queued")
+    first.source.profile = queued.source.profile = profile
+    try:
+        await slack.handle_message(first)
+        await asyncio.wait_for(started.wait(), 3)
+        await photon.handle_message(queued)
+        assert queued._gateway_deferred
+        assert shared_queue_size(runner, KEY) == 1
+        assert runner._send_busy_ack_reply.await_count == ack_count
+        release.set()
+        await idle(runner)
+        assert order == ["first", "queued"]
+        assert intake == ["first", "queued"]
+        assert slack.sent == [("slack-chat", "final:first")]
+        assert photon.sent == [("photon-chat", "final:queued")]
+        assert [row[1:3] for row in observed] == [("first", "success"), ("queued", "success")]
+    finally:
+        release.set()
+        await slack.cancel_background_tasks()
+        await photon.cancel_background_tasks()
+
+
+@pytest.mark.asyncio
+async def test_native_busy_path_can_queue_silently_then_deliver_real_reply(tmp_path, monkeypatch):
+    runner, photon, sent, calls, agent, release = await _busy(tmp_path, monkeypatch, steerable=False)
+    try:
+        home = Path(__import__("os").environ["HERMES_HOME"])
+        (home / "config.yaml").write_text(json.dumps({"shared_conversation": {"enabled": True},
+                                                       "display": {"busy_ack_enabled": False}}))
+        await photon._dispatch_inbound(_dm("answer this after the work", "m2"))
+        assert calls == ["long enrichment run"]
+        assert sent == []
+        release.set()
+        await _until(lambda: "ok: answer this after the work" in sent, "the real queued final reply")
+        assert calls == ["long enrichment run", "answer this after the work"]
+        assert sent == ["ok: long enrichment run", "ok: answer this after the work"]
+    finally:
+        release.set()
+        await photon.cancel_background_tasks()
