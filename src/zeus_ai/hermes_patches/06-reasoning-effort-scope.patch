diff --git a/tests/agent/test_background_review_separate_effort.py b/tests/agent/test_background_review_separate_effort.py
new file mode 100644
index 0000000000000000000000000000000000000000..5e2228862085b5ed72abb769867a39c88165a4a9
--- /dev/null
+++ b/tests/agent/test_background_review_separate_effort.py
@@ -0,0 +1,24 @@
+"""A separate review effort uses a cold digest, preserving the warm parent."""
+from types import SimpleNamespace
+from agent.background_review import _resolve_review_runtime, _fork_init_kwargs
+
+
+def parent():
+    return SimpleNamespace(provider='xai-oauth', model='grok-4.7', reasoning_config={'enabled':True,'effort':'medium'}, platform='cli', session_id='test-only', _current_main_runtime=lambda: {'api_mode':'codex_responses','base_url':'https://api.x.ai/v1','api_key':'test-only'})
+
+
+def test_explicit_separate_effort_uses_routed_branch():
+    agent=parent()
+    cfg={'provider':agent.provider,'model':agent.model,'reasoning_effort':'low','inherit_parent_reasoning':False}
+    rt=_resolve_review_runtime(agent,cfg)
+    assert rt['routed'] is True
+    kwargs=_fork_init_kwargs(agent,rt,True,1,cfg)
+    assert kwargs['reasoning_config']=={'enabled':True,'effort':'low'}
+    assert agent.reasoning_config=={'enabled':True,'effort':'medium'}
+    assert rt['model']==agent.model
+
+
+def test_default_same_model_preserves_warm_route():
+    agent=parent()
+    cfg={'provider':agent.provider,'model':agent.model,'reasoning_effort':'low'}
+    assert _resolve_review_runtime(agent,cfg)['routed'] is False
diff --git a/tests/agent/test_grok_effort_profile_scope.py b/tests/agent/test_grok_effort_profile_scope.py
