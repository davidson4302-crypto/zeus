diff --git a/tests/cron/test_deliver_gate.py b/tests/cron/test_deliver_gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..546844d87ab56a1466df7632da83c65e2bb4c7cc
--- /dev/null
+++ b/tests/cron/test_deliver_gate.py
@@ -0,0 +1,116 @@
+"""cron.deliver_gate: a profile can hold scheduled results and sends whole until a time its plugin names.
+
+Off unless the profile's config sets ``cron.deliver_gate``. Made-up data only.
+"""
+from __future__ import annotations
+
+import math
+from unittest.mock import Mock
+
+import pytest
+
+import cron.delivery_queue as queue
+
+
+@pytest.fixture
+def db(tmp_path, monkeypatch):
+    monkeypatch.setattr(queue, "DELIVERY_DB", tmp_path / "deliveries.db")
+    return tmp_path / "deliveries.db"
+
+
+def gate(monkeypatch, *, enabled=True, answers=None, raises=False):
+    monkeypatch.setattr(queue, "_gate_enabled", lambda: enabled)
+    calls = []
+
+    def invoke_hook(name, **kwargs):
+        calls.append((name, kwargs))
+        if raises:
+            raise RuntimeError("plugin broke")
+        return list(answers(kwargs) if callable(answers) else (answers or []))
+
+    import hermes_cli.lifecycle as lifecycle
+    monkeypatch.setattr(lifecycle, "invoke_hook", invoke_hook)
+    return calls
+
+
+def test_gate_off_sends_now_and_never_asks_the_hook(db, monkeypatch):
+    calls = gate(monkeypatch, enabled=False, answers=[{"deliver_after": 9e12}])
+    assert queue.deliver_gate({"id": "j"}, "hi") is None
+    assert calls == []
+
+
+def test_gate_off_drain_is_unchanged(db, monkeypatch):
+    gate(monkeypatch, enabled=False)
+    queue.enqueue("exec-1", {"id": "job-1"}, "brief")
+    send = Mock(return_value=None)
+    assert queue.drain(send) == 1
+    send.assert_called_once_with({"id": "job-1"}, "brief", False)
+
+
+@pytest.mark.parametrize("answers,expected", [
+    ([{"open": True}], None),
+    ([{"deliver_after": 2000.0}], 2000.0),
+    ([{"deliver_after": 2000.0}, {"deliver_after": 3000.0}, {"open": True}], 3000.0),   # latest hold wins
+    ([{"deliver_after": 500.0}], None),                                                 # already past
+    ([], math.inf),                                                                     # no answer: closed
+    ([None, "junk"], math.inf),
+    ([{"deliver_after": "soon"}], math.inf),
+])
+def test_gate_answers(db, monkeypatch, answers, expected):
+    gate(monkeypatch, answers=answers)
+    assert queue.deliver_gate({"id": "j"}, "hi", now=1000.0) == expected
+
+
+def test_hook_failure_fails_closed(db, monkeypatch):
+    gate(monkeypatch, raises=True)
+    assert queue.deliver_gate({"id": "j"}, "hi", now=1000.0) == math.inf
+
+
+def test_hold_is_idempotent_and_released_once_when_due(db, monkeypatch):
+    until = {"t": 2000.0}
+    gate(monkeypatch, answers=lambda kw: [{"deliver_after": until["t"]}])
+    queue.hold("exec-h", {"id": "job-h", "deliver": "chat"}, "morning note", deliver_after=2000.0)
+    queue.hold("exec-h", {"id": "job-h", "deliver": "chat"}, "changed", deliver_after=2000.0)
+    send = Mock(return_value=None)
+
+    monkeypatch.setattr(queue.time, "time", lambda: 1500.0)
+    assert queue.drain(send) == 0                     # not due: nothing claimed, nothing sent
+    send.assert_not_called()
+
+    until["t"] = 0.0                                  # the plugin now opens the gate
+    monkeypatch.setattr(queue.time, "time", lambda: 2500.0)
+    assert queue.drain(send) == 1
+    job, content, for_failure = send.call_args.args
+    assert content == "morning note" and job["id"] == "job-h" and job["_hold_released"] is True
+    assert queue.drain(send) == 0                     # sent exactly once
+    assert send.call_count == 1
+
+
+def test_due_hold_is_asked_again_and_stays_parked_if_still_closed(db, monkeypatch):
+    gate(monkeypatch, answers=[{"deliver_after": 9000.0}])
+    queue.hold("exec-x", {"id": "job-x"}, "late", deliver_after=1000.0)
+    send = Mock(return_value=None)
+    monkeypatch.setattr(queue.time, "time", lambda: 2000.0)
+    assert queue.drain(send) == 0
+    send.assert_not_called()
+
+
+def test_pending_row_queued_before_the_window_closed_is_parked_unclaimed(db, monkeypatch):
+    gate(monkeypatch, enabled=False)
+    queue.enqueue("exec-p", {"id": "job-p"}, "queued earlier")
+    gate(monkeypatch, answers=[{"deliver_after": 9e12}])
+    send = Mock(return_value=None)
+    assert queue.drain(send) == 0
+    send.assert_not_called()
+    assert queue.get_status("exec-p") is None or queue.get_status("exec-p")["status"] != "delivering"
+
+
+def test_cancelled_execution_is_not_sent_after_its_hold(db, monkeypatch):
+    gate(monkeypatch, answers=[{"open": True}])
+    queue.enqueue("exec-c", {"id": "job-c"}, "x")
+    queue.cancel_execution("exec-c", "user cancelled")
+    queue.hold("exec-c", {"id": "job-c"}, "x", deliver_after=0.0)
+    send = Mock(return_value=None)
+    queue.drain(send)
+    send.assert_not_called()
+
