+# ---- deliver_after holds -------------------------------------------------------------------------
+# Off unless the profile sets ``cron.deliver_gate: true``. A held delivery is parked whole (job with
+# its destination, content with its MEDIA tags) in ``delivery_holds`` BEFORE anything is claimed or
+# sent, so there is no outcome to guess. When its time comes it enters the ordinary queue through
+# ``enqueue`` and from there on every existing rule applies unchanged: claimed at most once, an
+# uncertain send is fenced ``unknown`` and never replayed, a cancelled execution stays cancelled.
+HOLD_RECHECK_SECONDS = 300.0
+_HOLDS_SCHEMA = """CREATE TABLE IF NOT EXISTS delivery_holds (
+    execution_id TEXT PRIMARY KEY,
+    job_json TEXT NOT NULL,
+    content TEXT NOT NULL,
+    for_failure INTEGER NOT NULL DEFAULT 0,
+    deliver_after REAL NOT NULL,
+    created_at TEXT NOT NULL
+)"""
+
+
+def _gate_enabled() -> bool:
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        return bool((load_config_readonly().get("cron") or {}).get("deliver_gate"))
+    except Exception:
+        return False
+
+
+def deliver_gate(
+    job: dict, content: str, *, for_failure: bool = False, surface: str = "cron",
+    now: Optional[float] = None,
+) -> Optional[float]:
+    """Epoch seconds before which this delivery must wait, or None to send now.
+
+    None at once unless the active profile sets ``cron.deliver_gate``. With it set, the profile's
+    ``pre_deliver`` hook decides: ``{"deliver_after": t}`` holds until ``t``, ``{"open": True}``
+    sends. The latest hold wins. No usable answer (plugin missing, hook raised) is ``math.inf``:
+    closed, until nobody knows when. ``hold`` parks that for ``HOLD_RECHECK_SECONDS`` and the gate
+    is asked again: a late message can be recovered, a sent one cannot.
+    """
+    if not _gate_enabled():
+        return None
+    at = time.time() if now is None else float(now)
+    try:
+        from hermes_cli.lifecycle import invoke_hook
+
+        answers = invoke_hook(
+            "pre_deliver", job=job, content=content, for_failure=for_failure, surface=surface)
+    except Exception:
+        logger.warning("Delivery gate hook failed; holding", exc_info=True)
+        answers = []
+    holds, opened = [], False
+    for answer in answers:
+        if not isinstance(answer, dict):
+            continue
+        if answer.get("deliver_after") is not None:
+            try:
+                holds.append(float(answer["deliver_after"]))
+            except (TypeError, ValueError):
+                holds.append(math.inf)
+        elif answer.get("open") is True:
+            opened = True
+    if holds:
+        return max(holds) if max(holds) > at else None
+    return None if opened else math.inf
+
+
+def hold(
+    execution_id: str, job: dict, content: str, *, deliver_after: float, for_failure: bool = False,
+) -> dict:
+    """Park one whole delivery until ``deliver_after``. Idempotent per execution id; touches no transport."""
+    if deliver_after == math.inf:
+        deliver_after = time.time() + HOLD_RECHECK_SECONDS
+    with _transaction() as conn:
+        conn.execute("BEGIN IMMEDIATE")
+        conn.execute(_HOLDS_SCHEMA)
+        conn.execute(
+            """INSERT OR IGNORE INTO delivery_holds
+               (execution_id, job_json, content, for_failure, deliver_after, created_at)
+               VALUES (?, ?, ?, ?, ?, ?)""",
+            (
+                str(execution_id),
+                json.dumps(job, ensure_ascii=False, sort_keys=True, default=str),
+                str(content),
+                int(bool(for_failure)),
+                float(deliver_after),
+                _hermes_now().isoformat(),
+            ),
+        )
+        row = conn.execute(
+            "SELECT execution_id, deliver_after, created_at FROM delivery_holds WHERE execution_id=?",
+            (str(execution_id),),
+        ).fetchone()
+    return dict(row)
+
+
+def sweep_holds(now: Optional[float] = None) -> bool:
+    """Run before a drain claims anything; returns whether this profile gates its deliveries.
+
+    A profile that never held anything and has the gate off does one read and returns. Otherwise:
+    a pending row the gate now closes (queued just before the window shut) is parked, never having
+    been claimed; a hold whose time has come is asked once more (the owner's clock may have moved)
+    and then enters the ordinary queue through ``enqueue``. ``enqueue`` is keyed by the same
+    execution id and honours the archive and tombstones, so a crash between its insert and the
+    delete below cannot produce a second send, and a cancelled execution is dropped unsent.
+    """
+    at = time.time() if now is None else float(now)
+    gated = _gate_enabled()
+    with _transaction() as conn:
+        has_holds = conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='delivery_holds'"
+        ).fetchone() is not None
+        if not gated and not has_holds:
+            return False
+        pending = [dict(row) for row in conn.execute(
+            "SELECT execution_id, job_json, content, for_failure FROM deliveries "
+            "WHERE status='pending'")] if gated else []
+        due = [dict(row) for row in conn.execute(
+            "SELECT * FROM delivery_holds WHERE deliver_after<=? "
+            "ORDER BY deliver_after, created_at, execution_id", (at,))] if has_holds else []
+    for row in pending:
+        wait = deliver_gate(
+            json.loads(row["job_json"]), row["content"], for_failure=bool(row["for_failure"]), now=at)
+        if wait is None:
+            continue
+        wait = min(wait, at + HOLD_RECHECK_SECONDS) if wait == math.inf else wait
+        with _transaction() as conn:
+            conn.execute("BEGIN IMMEDIATE")
+            conn.execute(_HOLDS_SCHEMA)
+            conn.execute(
+                """INSERT OR IGNORE INTO delivery_holds
+                   (execution_id, job_json, content, for_failure, deliver_after, created_at)
+                   SELECT execution_id, job_json, content, for_failure, ?, created_at
+                   FROM deliveries WHERE execution_id=? AND status='pending'""",
+                (wait, row["execution_id"]))
+            conn.execute(
+                "DELETE FROM deliveries WHERE execution_id=? AND status='pending'",
+                (row["execution_id"],))
+    for row in due:
+        job = json.loads(row["job_json"])
+        wait = deliver_gate(
+            job, row["content"], for_failure=bool(row["for_failure"]),
+            surface=str(job.get("_hold_surface") or "cron"), now=at)
+        if wait is not None:
+            with _transaction() as conn:
+                conn.execute(
+                    "UPDATE delivery_holds SET deliver_after=? WHERE execution_id=?",
+                    (at + HOLD_RECHECK_SECONDS if wait == math.inf else wait, row["execution_id"]))
+            continue
+        enqueue(row["execution_id"], job, row["content"], for_failure=bool(row["for_failure"]))
+        with _transaction() as conn:
+            conn.execute("DELETE FROM delivery_holds WHERE execution_id=?", (row["execution_id"],))
+    return gated
+
