+def cancel_execution(execution_id: str, reason: str) -> dict:
+    """Cancel one exact execution's queued or held delivery in the active profile.
+
+    A tombstone written before any enqueue keeps a later enqueue (including a hold released by
+    ``sweep_holds``) from sending. A pending row is suppressed atomically against claim; a claimed
+    send keeps its real outcome because cancellation cannot unsend it. Callers own authorization and
+    pass an exact execution id, never a job id.
+    """
+    if not isinstance(execution_id, str) or not execution_id.strip():
+        raise ValueError("A nonempty execution id is required.")
+    if not isinstance(reason, str) or not reason.strip():
+        raise ValueError("A cancellation reason is required.")
+    safe_reason = redact_sensitive_text(reason, force=True)[:2048]
+    with _transaction() as conn:
+        conn.execute("BEGIN IMMEDIATE")
+        stamp = _hermes_now().isoformat()
+        row = conn.execute("SELECT status FROM deliveries WHERE execution_id=?", (execution_id,)).fetchone()
+        if row is None:
+            conn.execute(
+                """INSERT OR IGNORE INTO delivery_tombstones
+                   (execution_id, terminal_status, finished_at) VALUES (?, 'suppressed', ?)""",
+                (execution_id, stamp),
+            )
+        elif row["status"] == "pending":
+            conn.execute(
+                """UPDATE deliveries SET status='suppressed', finished_at=?, error=?
+                   WHERE execution_id=? AND status='pending'""",
+                (stamp, safe_reason, execution_id),
+            )
+        has_holds = conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='delivery_holds'").fetchone()
+        if has_holds:
+            conn.execute("DELETE FROM delivery_holds WHERE execution_id=?", (execution_id,))
+        now = conn.execute("SELECT status FROM deliveries WHERE execution_id=?", (execution_id,)).fetchone()
+        status = now["status"] if now is not None else "suppressed"
+    return {
+        "execution_id": execution_id,
+        "status": status,
+        "cancellation_requested": True,
+        "in_flight": status == "delivering",
+        "prevented": status == "suppressed",
+        "reconciliation_required": status in {"delivering", "failed", "unknown"},
+    }
+
