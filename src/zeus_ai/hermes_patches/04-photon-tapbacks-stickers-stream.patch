+# --------------------------------------------------------------------------- Tapbacks that mean something
+# Opt in per profile with `photon.extra.reactions: meaning` (`true` keeps 👀-then-👍 on every message).
+# Routing in code: the user's words pick the first tapback; the turn's durable records pick the last one.
+# A model never picks the emoji (code would have to re-check every pick against the same evidence anyway), and
+# there is no reflexive 👍 on every reply (it says "got it" after a full answer and never "done").
+#   first   👀 while work runs | ❤️ for a thanks | 👍 for a plain "ok" | nothing on a hello or goodnight
+#   last    ⏰ a reminder or timed check was set and read back this turn | ✅ the ledger closed their item this turn |
+#           ❤️ a thanks | 👍 a plain ack, or a reply that was only "Got it" (sent as the tapback, no text) |
+#           nothing when a text reply already says it all
+# Optional extras: `tapback_names` (names the user may add, "thanks Sam"), `tapback_life_cli` (the life-engine
+# command whose read-back output proves a reminder or a close; default ``zeus-life``).
+_EYES, _OK, _HEART, _DONE, _ALARM, _THUMBS_DOWN = "\U0001f440", "\U0001f44d", "❤️", "✅", "⏰", "\U0001f44e"
+MEANING_TAPBACKS = frozenset({_EYES, _OK, _HEART, _DONE, _ALARM})
+
+_TB_TAIL = r"[\s,.!~☀-➿️‍\U0001f300-\U0001faff]*"
+_TB_NAME_WORDS = ("bud", "man", "buddy", "friend")
+
+
+def _tb_name(names: Any = ()) -> str:
+    """An optional trailing name: generic words plus the configured ``tapback_names``."""
+    words = [re.escape(str(n).strip().lower()) for n in (names or ()) if str(n).strip()]
+    return r"(?:,?\s*(?:" + "|".join(words + list(_TB_NAME_WORDS)) + r"))?"
+_TB_THANKS = (r"(?:thanks?(?: (?:so|very) much| a lot| a ton| again| man| bud)?|thank (?:you|u)(?: (?:so|very) much)?|thx|tysm|ty|"
+              r"appreciate (?:it|you|that)|(?:i )?love (?:it|you|that|this)|you(?:'re| are) the best|you rock|"
+              r"(?:amazing|awesome|great|nice) (?:job|work)|nicely done|well done|[❤\U0001f64f\U0001f970\U0001f60d]️?)")
+_TB_ACK = (r"(?:ok(?:ay|ey)?|k{1,2}|got it|gotcha|sounds (?:good|great)|cool|nice|perfect|great|awesome|sweet|noted|"
+           r"will do|roger(?: that)?|copy(?: that)?|understood|makes sense|all good|word|bet|\U0001f44d[\U0001f3fb-\U0001f3ff]?|\U0001f44c)")
+_TB_HELLO = (r"(?:(?:good ?)?(?:morning|mornin|night|nite|evening|afternoon)|gm|gn|night night|hi|hey|heya|hello|hiya|yo|howdy|"
+             r"(?:i'?m |im |i am |just )?(?:back|home)(?: home| now| again| safe)?|made it(?: back| home)?|(?:just )?landed|"
+             r"(?:heading|headed|off|going) to (?:bed|sleep)|sleep well|bye|later|ttyl|talk (?:tomorrow|later|soon)|cya|see ya|"
+             r"have a good (?:night|one|evening|day))")
+
+
+def _tb_norm(text: Any) -> str:
+    return " ".join(str(text or "").replace("’", "'").strip().lower().split())
+
+
+def _tb_only(text: str, words: str, *, joiner: str = "", names: Any = ()) -> bool:
+    """True when ``text`` is nothing but one or more of ``words`` (plus a name, punctuation and emoji)."""
+    if not text or len(text) > 60:
+        return False
+    unit = words + _tb_name(names) + _TB_TAIL
+    return re.fullmatch(r"(?:" + unit + r")+" if not joiner else unit + r"(?:" + joiner + unit + r")*", text) is not None
+
+
+def user_thanks(text: Any, names: Any = ()) -> bool:
+    t = _tb_norm(text)
+    return bool(t) and re.search(_TB_THANKS, t) is not None and \
+        _tb_only(t, r"(?:" + _TB_THANKS + "|" + _TB_ACK + ")", names=names)
+
+
+def user_plain_ack(text: Any, names: Any = ()) -> bool:
+    return _tb_only(_tb_norm(text), _TB_ACK, names=names)
+
+
+def user_hello(text: Any, names: Any = ()) -> bool:
+    return _tb_only(_tb_norm(text), r"(?:" + _TB_HELLO + "|" + _TB_ACK + ")", names=names) and \
+        not user_plain_ack(text, names)
+
+
+def asks_question(text: Any) -> bool:
+    """A question the user asked never gets a tapback in place of an answer (conservative: any "?" or a question opener)."""
+    t = _tb_norm(text)
+    return "?" in t or re.match(r"(?:what|when|where|who|whom|whose|why|how|which|is|are|am|was|were|do|does|did|can|could|"
+                                r"will|would|should|shall|may|might|have|has|any|anything|status|update)\b", t) is not None
+
+
+def opening_tapback(text: Any, names: Any = ()) -> Optional[str]:
+    """The first tapback, from the user's words alone, placed as soon as the turn starts."""
+    if user_thanks(text, names):
+        return _HEART
+    if user_plain_ack(text, names):
+        return _OK
+    if user_hello(text, names) or not _tb_norm(text) or _tb_norm(text).startswith("/"):
+        return None   # a hello gets words back; a /command is answered by the gateway itself
+    return _EYES
+
+
+# The agent's whole reply only acknowledges: no fact, draft, link, question, promise or claim of done.
+_TB_BARE_REPLY = (r"(?:got it|gotcha|will do|noted|ok(?:ay)?|sounds good|sure(?: thing)?|you got it|of course|any ?time|"
+                  r"you(?:'re| are) (?:very )?welcome|my pleasure|no problem|no worries|np|perfect|great|understood|"
+                  r"roger(?: that)?|copy(?: that)?|love (?:it|that)|thanks?(?: for (?:letting me know|the heads up))?|thank you|"
+                  r"\U0001f44d[\U0001f3fb-\U0001f3ff]?|\U0001f44c|\U0001f64f|❤️?|\U0001f64c|\U0001f60a)")
+
+
+def is_bare_ack_reply(text: Any, names: Any = ()) -> bool:
+    t = _tb_norm(text)
+    return len(t) <= 40 and "?" not in t and _tb_only(t, _TB_BARE_REPLY, joiner=r"[\s,.!]*", names=names)
+
+
+def pick_final_tapback(user_text: Any, *, evidence: Any = (), tapback_only: bool = False,
+                       names: Any = ()) -> Optional[str]:
+    """The tapback left on the user's message when the turn ends. Code decides; ✅ and ⏰ only from ``evidence``."""
+    ev = set(evidence or ())
+    if "timer" in ev:
+        return _ALARM
+    if "done" in ev:
+        return _DONE
+    if user_thanks(user_text, names):
+        return _HEART
+    if tapback_only or user_plain_ack(user_text, names):
+        return _OK
+    return None
+
+
+# Helpers: a chat turn that handed the user's ask to a background helper keeps its 👀 until the helper's result is
+# delivered, and the holding line it ends with ("On it.") is not sent: the 👀 says it. The signal is the helper
+# guard's own record, written by a delegation-guard plugin as it happens (never the model's words):
+#   <profile>/workspace/life-engine/helper-turns.jsonl  started (delegation dispatched for the user's message), waiting
+#   (refused for room and kept; started later under a new delegation id for the same message), stopped (user's stop).
+# No such file means no helper holds.
+HELPER_TURNS = "helper-turns.jsonl"
+HELPER_KEEP = 6 * 3600      # a hold older than this is let go at the next result in that chat (its helper is long gone)
+_TB_HOLDING = (r"(?:on it|i'?m on it|on it now|looking(?: into it| now)?|checking(?: now| on it)?|working on it|"
+               r"give me (?:a )?(?:minute|sec(?:ond)?|moment|bit)|one (?:sec|moment|minute)|let me (?:look|check|dig)(?: into it)?|"
+               r"will do|got it|on the case)")
+_TB_RESULT_IDS = re.compile(r"deleg_[0-9a-zA-Z]+")
+
+
+def is_holding_line(text: Any, names: Any = ()) -> bool:
+    """The chat's whole reply only says it is on it (no fact, link, question or promise of a time)."""
+    t = _tb_norm(text)
+    return len(t) <= 40 and "?" not in t and (_tb_only(t, _TB_HOLDING, joiner=r"[\s,.!]*", names=names)
+                                              or is_bare_ack_reply(text, names))
+
+
+def is_helper_result(text: Any) -> bool:
+    return bool(re.match(r"\s*\[(?:ASYNC DELEGATION|IMPORTANT: \d+ background subagent delegations)", str(text or "")))
+
+
+_TB_LIFE_CLI_DEFAULT = "zeus-life"
+
+
+def _tb_life_cli(name: Any = None) -> str:
+    """The life-engine command as typed in a terminal call, bare or from ~/.local/bin."""
+    cli = str(name or _TB_LIFE_CLI_DEFAULT).strip()
+    if not re.fullmatch(r"[A-Za-z0-9_.-]+", cli):
+        cli = _TB_LIFE_CLI_DEFAULT
+    return r"(?:(?:~|" + re.escape(str(Path.home())) + r")/\.local/bin/)?" + re.escape(cli)
+_TB_UNSAFE = re.compile(r"[;&|`$<>\\\n]")
+
+
+def _tb_json(value: Any) -> Any:
+    try:
+        return json.loads(value) if isinstance(value, str) else value
+    except (TypeError, ValueError):
+        return None
+
+
+def _tb_time(value: Any) -> Optional[float]:
+    try:
+        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
+    except (TypeError, ValueError):
+        return None
+
+
+def terminal_results(rows: List[Dict[str, Any]]) -> List[Tuple[str, str]]:
+    """(command, output) for each terminal call in this turn that exited 0. Commands are read, never run."""
+    pending: Dict[str, str] = {}
+    results: List[Tuple[str, str]] = []
+    for row in rows:
+        if row.get("role") == "assistant":
+            for call in _tb_json(row.get("tool_calls")) or []:
+                fn = (call or {}).get("function") or {}
+                args = _tb_json(fn.get("arguments")) or {}
+                if fn.get("name") == "terminal" and call.get("id") and isinstance(args.get("command"), str):
+                    pending[call["id"]] = args["command"].strip()
+        elif row.get("role") == "tool" and row.get("tool_name") == "terminal" and row.get("tool_call_id") in pending:
+            body = _tb_json(row.get("content")) or {}
+            command = pending.pop(row["tool_call_id"])
+            if body.get("exit_code") == 0 and not body.get("error") and isinstance(body.get("output"), str):
+                results.append((command, body["output"].strip()))
+    return results
+
+
+def turn_evidence(rows: List[Dict[str, Any]], ledger: Callable[[str, Tuple[Any, ...]], List[Dict[str, Any]]],
+                  since: float, life_dir: Optional[Path] = None, life_cli: Any = None) -> set:
+    """What this turn really did, from durable records only: 'timer' and/or 'done'.
+
+    ``rows`` are this turn's state.db rows after the user's message; ``ledger(sql, args)`` reads the life ledger.
+    A tool's printed words alone never count: each claim is read back from the ledger or a second command.
+    Same records the reminder_set status sticker trusts (outcome-status.mjs)."""
+    found: set = set()
+    cli = _tb_life_cli(life_cli)
+    calls = [(c, o) for c, o in terminal_results(rows) if not _TB_UNSAFE.search(c)]
+    created: Dict[str, Dict[str, Any]] = {}
+    for command, output in calls:
+        m = re.fullmatch(cli + r" reminder ['\"]?([A-Za-z0-9_:#.~/-]+)['\"]?", command)
+        if m and re.match(r"(?:Set and read back:|It is there:)", output):
+            for row in ledger("SELECT payload FROM opps WHERE key=?", (m.group(1),)):
+                spec = ((_tb_json(row.get("payload")) or {}).get("research") or {}).get("reminder") or {}
+                seen = spec.get("read_back") or {}
+                if spec.get("state") == "created" and seen.get("id") and (spec.get("claimed_at") or 0) >= since:
+                    found.add("timer")
+        m = re.fullmatch(cli + r" add .+ --due \S+", command)
+        key = re.search(r"Key: (\S+)\s*$", output)
+        if m and key and output.startswith("Added. It will be worked on "):
+            if ledger("SELECT 1 FROM opps WHERE key=? AND state='pending' AND first_seen>=?", (key.group(1), since)):
+                found.add("timer")
+        if re.match(r"(?:/opt/homebrew/bin/)?remindctl (?:add|info) ", command) and re.search(r"(?:^|\s)(?:--json|-j)(?:\s|$)", command):
+            body = _tb_json(output)
+            r = body[0] if isinstance(body, list) and len(body) == 1 else body
+            if isinstance(r, dict) and r.get("id") and r.get("title") and r.get("isCompleted") is False and _tb_time(r.get("dueDate")):
+                if " add " in f" {command} ":
+                    created[r["id"]] = r
+                elif (prior := created.get(r["id"])) and prior["title"] == r["title"] and _tb_time(prior["dueDate"]) == _tb_time(r["dueDate"]):
+                    found.add("timer")
+        m = re.fullmatch(cli + r" (done|drop|mute) .+", command)
+        if m:
+            said = {"done": "Closed as done: ", "drop": "Dropped (this item only): ", "mute": "Closed and muted:"}[m.group(1)]
+            state = "done" if m.group(1) == "done" else "declined"
+            if output.startswith(said):
+                title = output[len(said):].split("\n", 1)[0].strip() if m.group(1) != "mute" else None
+                for row in ledger("SELECT payload FROM opps WHERE state=? AND updated>=?", (state, since)):
+                    if title is None or str((_tb_json(row.get("payload")) or {}).get("title")) == title:
+                        found.add("done")
+        if re.fullmatch(cli + r" stop", command) and output.startswith("Life pipes are stopped") \
+                and life_dir is not None and (life_dir / "off").exists():
+            found.add("done")
+    return found
+
