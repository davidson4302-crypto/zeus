diff --git a/tests/plugins/platforms/photon/test_helper_eyes.py b/tests/plugins/platforms/photon/test_helper_eyes.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc2b66bcf005a5c42f36f4be77a011e1700849b7
--- /dev/null
+++ b/tests/plugins/platforms/photon/test_helper_eyes.py
@@ -0,0 +1,136 @@
+"""Tapbacks with background helpers, reactions=meaning only.
+
+A chat turn that hands a long job to a background helper ends in seconds. Its 👀 stays on the user's message until the
+helper's result has been delivered; the chat's holding line ("On it.") does not go out as text, because the 👀 says it.
+The signal is the helper guard's own record (workspace/life-engine/helper-turns.jsonl: started / waiting / stopped),
+written by the delegation guard when delegate_task really dispatched, was refused for room and kept, or the user said stop.
+Made-up wording only; the sidecar is a fake that records calls.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+from pathlib import Path
+
+import plugins.platforms.photon.adapter as A
+from gateway.platforms.event import MessageEvent, MessageType, ProcessingOutcome
+
+from test_meaning_tapbacks import CHAT, EYES, MSG, OBLIGATION, adapter, event, reacts, texts
+
+MSG2 = "spc-msg-fixture-2"
+
+
+def note(home: Path, kind, message=MSG, **more):
+    life = home / "workspace" / "life-engine"
+    life.mkdir(parents=True, exist_ok=True)
+    row = dict(at=time.time(), kind=kind, platform="photon", chat=CHAT, message=message, **more)
+    with open(life / "helper-turns.jsonl", "a") as fh:
+        fh.write(json.dumps(row) + "\n")
+
+
+def result_event(a, delegation):
+    return MessageEvent(text=f"[ASYNC DELEGATION COMPLETE — {delegation}]\nRESULT: made-up finding",
+                        message_type=MessageType.TEXT, internal=True,
+                        source=a.build_source(chat_id=CHAT, chat_name=CHAT, chat_type="dm", user_id="+15550001111", user_name=None))
+
+
+async def user_turn(a, home, text, replies, message=MSG, notes=()):
+    ev = event(a, text, message_id=message)
+    await a.on_processing_start(ev)
+    for kind, more in notes:
+        note(home, kind, message=message, **more)
+    for reply in replies:
+        await a.send(CHAT, reply, metadata=OBLIGATION)
+    await a.on_processing_complete(ev, ProcessingOutcome.SUCCESS)
+
+
+async def result_turn(a, delegation, reply="Found it: made-up finding"):
+    ev = result_event(a, delegation)
+    await a.on_processing_start(ev)
+    await a.send(CHAT, reply, metadata={"_delivery_obligation_id": "obl-r"})
+    await a.on_processing_complete(ev, ProcessingOutcome.SUCCESS)
+
+
+def test_eyes_stay_while_the_helper_works_and_go_when_its_result_is_delivered(tmp_path):
+    a, calls = adapter(tmp_path)
+
+    async def run():
+        await user_turn(a, tmp_path, "can you research the best price for a widget?", ["On it."],
+                       notes=[("started", {"delegation": "deleg_aaa111"})])
+        mid = list(reacts(calls))
+        await result_turn(a, "deleg_aaa111")
+        return mid
+    mid = asyncio.run(run())
+    assert mid == [("/react", EYES)]                                   # kept at the end of the turn
+    assert texts(calls) == ["Found it: made-up finding"]               # "On it." was never sent; the result was
+    assert reacts(calls) == [("/react", EYES), ("/unreact", None)]     # removed only after the result went out
+
+
+def test_a_holding_line_without_a_helper_is_still_sent(tmp_path):
+    a, calls = adapter(tmp_path)
+    asyncio.run(user_turn(a, tmp_path, "can you research the best price for a widget?", ["On it."]))
+    assert texts(calls) == ["On it."]
+    assert reacts(calls) == [("/react", EYES), ("/unreact", None)]
+
+
+def test_a_real_answer_in_a_helper_turn_is_sent_and_eyes_still_wait(tmp_path):
+    a, calls = adapter(tmp_path)
+    asyncio.run(user_turn(a, tmp_path, "research a couch, and what's 17% of 240?", ["On it. And 17% of 240 is 40.8."],
+                         notes=[("started", {"delegation": "deleg_bbb222"})]))
+    assert texts(calls) == ["On it. And 17% of 240 is 40.8."]
+    assert reacts(calls) == [("/react", EYES)]
+
+
+def test_queued_fourth_job_keeps_eyes_until_its_own_result(tmp_path):
+    a, calls = adapter(tmp_path)
+
+    async def run():
+        await user_turn(a, tmp_path, "long job 1", ["On it."], notes=[("started", {"delegation": "deleg_one111"})])
+        await user_turn(a, tmp_path, "long job 4", ["That one starts as soon as one of the others is done."],
+                       message=MSG2, notes=[("waiting", {})])
+        assert reacts(calls) == [("/react", EYES), ("/react", EYES)]
+        # job 1's result comes back; on that turn the guard starts the waiting job for message 2
+        ev = result_event(a, "deleg_one111")
+        await a.on_processing_start(ev)
+        note(tmp_path, "started", message=MSG2, delegation="deleg_four44")
+        await a.send(CHAT, "Found it: job one", metadata={"_delivery_obligation_id": "obl-r1"})
+        await a.on_processing_complete(ev, ProcessingOutcome.SUCCESS)
+        after_one = [c for c in reacts(calls)]
+        await result_turn(a, "deleg_four44", "Found it: job four")
+        return after_one
+    after_one = asyncio.run(run())
+    assert after_one == [("/react", EYES), ("/react", EYES), ("/unreact", None)]   # only message 1 released
+    assert reacts(calls) == [("/react", EYES), ("/react", EYES), ("/unreact", None), ("/unreact", None)]
+    assert a._helper_holds == {}
+    assert texts(calls) == ["That one starts as soon as one of the others is done.", "Found it: job one", "Found it: job four"]
+
+
+def test_user_stop_releases_the_eyes(tmp_path):
+    a, calls = adapter(tmp_path)
+
+    async def run():
+        await user_turn(a, tmp_path, "research a widget", ["On it."], notes=[("started", {"delegation": "deleg_ccc333"})])
+        await user_turn(a, tmp_path, "stop", ["Stopped."], message=MSG2, notes=[("stopped", {})])
+    asyncio.run(run())
+    assert reacts(calls) == [("/react", EYES), ("/react", EYES), ("/unreact", None), ("/unreact", None)]
+    assert texts(calls) == ["Stopped."]
+    assert a._helper_holds == {}
+
+
+def test_a_hold_whose_helper_never_came_back_is_let_go_after_six_hours(tmp_path):
+    a, calls = adapter(tmp_path)
+
+    async def run():
+        await user_turn(a, tmp_path, "research a widget", ["On it."], notes=[("started", {"delegation": "deleg_lost01"})])
+        a._helper_holds[list(a._helper_holds)[0]][MSG]["at"] -= A.HELPER_KEEP + 1
+        await result_turn(a, "deleg_other2")
+    asyncio.run(run())
+    assert reacts(calls) == [("/react", EYES), ("/unreact", None)]
+    assert a._helper_holds == {}
+
+
+def test_other_lines_on_reactions_true_are_unchanged(tmp_path):
+    a, calls = adapter(tmp_path, mode="true")
+    asyncio.run(user_turn(a, tmp_path, "research a widget", ["On it."], notes=[("started", {"delegation": "deleg_eee555"})]))
+    assert texts(calls) == ["On it."]
diff --git a/tests/plugins/platforms/photon/test_link_bubbles.py b/tests/plugins/platforms/photon/test_link_bubbles.py
new file mode 100644
index 0000000000000000000000000000000000000000..0f7222911a5d390bfb231724ffcf630759861ced
--- /dev/null
+++ b/tests/plugins/platforms/photon/test_link_bubbles.py
@@ -0,0 +1,107 @@
+"""A link that ends its line goes out in its own bubble (so iMessage shows the preview card).
+
+Made-up wording and example.test addresses only.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Tuple
+
+import pytest
+
+from gateway.config import PlatformConfig
+from plugins.platforms.photon import adapter as photon_adapter
+from plugins.platforms.photon.adapter import PhotonAdapter
+
+CHAT = "+155****4567"
+
+
+def make(monkeypatch, **extra) -> PhotonAdapter:
+    monkeypatch.setenv("PHOTON_PROJECT_ID", "test-project-id")
+    monkeypatch.setenv("PHOTON_PROJECT_SECRET", "test-project-secret")
+    monkeypatch.setenv("PHOTON_NODE_BIN", "/test/node")
+    monkeypatch.delenv("PHOTON_MARKDOWN", raising=False)
+    monkeypatch.delenv("PHOTON_LINK_BUBBLES", raising=False)
+    return PhotonAdapter(PlatformConfig(enabled=True, token="", extra=dict(extra)))
+
+
+def capture(adapter, fail_at=None) -> List[Tuple[str, Dict[str, Any]]]:
+    calls: List[Tuple[str, Dict[str, Any]]] = []
+
+    async def fake(path, body):
+        calls.append((path, body))
+        if fail_at is not None and len(calls) == fail_at:
+            raise photon_adapter.PhotonSidecarError(path=path, status_code=400, error="refused", error_class="sidecar_error",
+                                                    retryable=False)
+        return {"ok": True, "messageId": f"m{len(calls)}"}
+
+    adapter._sidecar_call = fake  # type: ignore[assignment]
+    return calls
+
+
+REPLY = "Your order shipped, arrives Friday.\nTracking: https://track.example.test/abc123\nIt needs a signature."
+
+
+@pytest.mark.asyncio
+async def test_line_ending_link_gets_its_own_bubble(monkeypatch):
+    a = make(monkeypatch, link_bubbles=True)
+    calls = capture(a)
+    res = await a.send(CHAT, REPLY)
+    assert res.success
+    assert [p for p, _ in calls] == ["/send", "/send-richlink", "/send"]
+    assert calls[0][1]["text"] == "Your order shipped, arrives Friday.\nTracking:"
+    assert calls[1][1]["url"] == "https://track.example.test/abc123"
+    assert calls[2][1]["text"] == "It needs a signature."
+    assert res.message_id == "m3" and res.continuation_message_ids == ("m1", "m2")
+
+
+@pytest.mark.asyncio
+async def test_off_by_default_one_bubble_as_before(monkeypatch):
+    a = make(monkeypatch)
+    calls = capture(a)
+    await a.send(CHAT, REPLY)
+    assert [p for p, _ in calls] == ["/send"]
+
+
+def test_split_never_loses_a_character():
+    text = ("Two picks.\n- Blue one: https://shop.example.test/blue.\n- Red one (https://shop.example.test/red)\n\n"
+            "Blue ships faster.")
+    parts = photon_adapter._link_bubbles(text)
+    assert parts == ["Two picks.\n- Blue one:", "https://shop.example.test/blue", "- Red one",
+                     "https://shop.example.test/red", "Blue ships faster."]
+    squash = lambda s: "".join(ch for ch in s if ch.isalnum())
+    assert squash("".join(parts)) == squash(text)
+
+
+@pytest.mark.parametrize("text", [
+    "Sign in here: https://login.example.test/x (works for 2 hours)",          # mid-sentence: stays
+    'Send this: "Hi Dana, the form is at https://forms.example.test/f"',       # inside a draft: stays
+    "```\nhttps://code.example.test\n```",                                      # code block: stays
+    "https://only.example.test/page",                                           # already its own bubble
+    "No link here at all.",
+])
+def test_left_alone(text):
+    assert photon_adapter._link_bubbles(text) == [text]
+
+
+def test_markdown_link_keeps_its_label():
+    assert photon_adapter._link_bubbles("Here is the [return form](https://r.example.test/f).") == \
+        ["Here is the return form", "https://r.example.test/f"]
+
+
+def test_at_most_three_links_lifted():
+    text = "\n".join(f"Link {i}: https://l.example.test/{i}" for i in range(5))
+    parts = photon_adapter._link_bubbles(text)
+    assert sum(p.startswith("https://") for p in parts) == 3
+    assert parts[-1] == "Link 3: https://l.example.test/3\nLink 4: https://l.example.test/4"
+
+
+@pytest.mark.asyncio
+async def test_failure_midway_is_partial_so_nothing_is_resent(monkeypatch):
+    a = make(monkeypatch, link_bubbles=True)
+    calls = capture(a, fail_at=3)          # the last prose bubble is refused after the first two went
+    res = await a._send_with_retry(chat_id=CHAT, content=REPLY)
+    assert not res.success
+    assert (res.raw_response or {}).get("partial_overflow") is True
+    # the first bubble went once; no plain-text fallback re-sent the whole reply
+    assert [b.get("text") for p, b in calls if p == "/send"].count("Your order shipped, arrives Friday.\nTracking:") == 1
+    assert not any(REPLY in str(b.get("text", "")) for _, b in calls)
diff --git a/tests/plugins/platforms/photon/test_meaning_tapbacks.py b/tests/plugins/platforms/photon/test_meaning_tapbacks.py
