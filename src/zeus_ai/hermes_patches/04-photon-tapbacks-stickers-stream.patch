+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRefreshableStream, refreshQuietStream } from './refreshable-stream.mjs';
+import { createStreamGroup } from '@spectrum-ts/core/authoring';
+import { isZombieSuspect, shouldProbe, classifyProbeRejection } from './stream-staleness.mjs';
+function wire() {
+  let pending; let closed = false; let closeCount = 0;
+  return {
+    get closeCount() { return closeCount; },
+    push(value) { pending?.({value,done:false}); pending = null; },
+    [Symbol.asyncIterator]() { return this; },
+    next() { return closed ? Promise.resolve({done:true}) : new Promise(r => { pending=r; }); },
+    async close() { if (!closed) { closed=true; closeCount++; pending?.({done:true}); } },
+    async return() { await this.close(); return {done:true}; },
+  };
+}
+const turn = () => new Promise(r => setImmediate(r));
+test('refresh closes the old SDK stream and receives on a new wire while sends remain usable', async () => {
+  const wires = []; let clientClosed=false;
+  const stream = createRefreshableStream(() => {
+    const source=wire(); wires.push(source);
+    const group=createStreamGroup(); group.add('line', () => source); return group;
+  });
+  const iterator=stream[Symbol.asyncIterator]();
+  const first=iterator.next(); await turn();
+  wires[0].push('before'); assert.equal((await first).value,'before');
+  const next=iterator.next(); await turn();
+  assert.equal(await stream.refresh(),true); await turn();
+  assert.equal(wires[0].closeCount,1); assert.equal(wires.length,2);
+  const send=async () => { assert.equal(clientClosed,false); return 'receipt'; };
+  assert.equal(await send(),'receipt');
+  wires[1].push('after'); assert.equal((await next).value,'after');
+  await iterator.return(); assert.equal(wires[1].closeCount,1);
+});
+test('quiet-stream guard preserves cooldown, ignores inconclusive and superseded probes, and coalesces refreshes', async () => {
+  const threshold=21600000;
+  assert.equal(shouldProbe(600000,threshold,600000,120000),false);
+  assert.equal(shouldProbe(threshold,threshold,1000,120000),false);
+  assert.equal(isZombieSuspect(threshold,threshold,classifyProbeRejection({code:14,message:'unavailable'})),false);
+  let calls=0;const stub={refresh:async()=>{calls++;return true;}};
+  assert.equal(await refreshQuietStream({stream:stub,observedInboundAt:1,lastInboundAt:2}),false);
+  assert.equal(calls,0);
+  let release;let closed=0;
+  const stream=createRefreshableStream(()=>({
+    [Symbol.asyncIterator](){return this;},next(){return new Promise(()=>{});},
+    close(){closed++;return new Promise(r=>{release=r;});}
+  }));
+  void stream[Symbol.asyncIterator]().next();
+  const refresh=stream.refresh();assert.equal(await stream.refresh(),false);
+  assert.equal(closed,1);release();assert.equal(await refresh,true);
+});
