index 0000000000000000000000000000000000000000..e24ce0aa236ec8409e961a6ad6d26a974ccb8b88
--- /dev/null
+++ b/tests/plugins/platforms/photon/test_meaning_tapbacks.py
@@ -0,0 +1,269 @@
+"""Tapbacks that mean something, for reactions=meaning only.
+
+Made-up wording only. No Node, no ports, no network: the sidecar is a fake that
+records calls, and the evidence is a temp state.db and ledger built here.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import sqlite3
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+import plugins.platforms.photon.adapter as A
+from gateway.config import PlatformConfig
+from gateway.platforms.event import MessageEvent, MessageType, ProcessingOutcome
+
+EYES, OK, HEART, DONE, ALARM, DOWN = "\U0001f440", "\U0001f44d", "❤️", "✅", "⏰", "\U0001f44e"
+CHAT, MSG = "any;-;+15550001111", "spc-msg-fixture-1"
+OBLIGATION = {"_delivery_obligation_id": "obl-1"}
+
+
+@pytest.fixture(autouse=True)
+def _no_node(monkeypatch):
+    monkeypatch.setenv("PHOTON_NODE_BIN", "/test/node")
+    monkeypatch.setenv("PHOTON_PROJECT_ID", "test-project-id")
+    monkeypatch.setenv("PHOTON_PROJECT_SECRET", "test-project-secret")
+
+
+def adapter(tmp_path: Path, mode: str = "meaning", slow: float = 0.0):
+    a = A.PhotonAdapter(PlatformConfig(enabled=True, token="", extra={"reactions": mode, "tapback_names": ["Sam"]}))
+    calls = []
+
+    async def fake_call(path, body):
+        if path == "/react" and slow:
+            await asyncio.sleep(slow)
+        calls.append((path, body.get("emoji") if path == "/react" else body.get("text")))
+        return {"ok": True, "messageId": "out-1", "reactionId": "r-1"}
+
+    a._sidecar_call = fake_call
+    a._profile_home = lambda: tmp_path
+    return a, calls
+
+
+def event(a, text, message_id=MSG):
+    return MessageEvent(text=text, message_type=MessageType.TEXT, message_id=message_id,
+                        timestamp=datetime.now(tz=timezone.utc),
+                        source=a.build_source(chat_id=CHAT, chat_name=CHAT, chat_type="dm", user_id="+15550001111", user_name=None))
+
+
+def reacts(calls):
+    return [c for c in calls if c[0] in ("/react", "/unreact")]
+
+
+def texts(calls):
+    return [c[1] for c in calls if c[0] == "/send"]
+
+
+async def turn(a, text, replies=(), outcome=ProcessingOutcome.SUCCESS, before_complete=None):
+    ev = event(a, text)
+    await a.on_processing_start(ev)
+    for reply in replies:
+        await a.send(CHAT, reply, metadata=OBLIGATION)
+    if before_complete:
+        before_complete()
+    await a.on_processing_complete(ev, outcome)
+
+
+# -- evidence fixtures (made-up items) -------------------------------------------------------------------------
+
+def make_state(home: Path, calls_and_outputs):
+    """state.db with the user's message then one terminal call/result per (command, output)."""
+    db = sqlite3.connect(home / "state.db")
+    db.execute("CREATE TABLE messages (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT, role TEXT, content TEXT,"
+               " tool_call_id TEXT, tool_calls TEXT, tool_name TEXT, timestamp REAL, platform_message_id TEXT)")
+    now = time.time()
+    db.execute("INSERT INTO messages(session_id,role,content,timestamp,platform_message_id) VALUES('s','user','x',?,?)", (now, MSG))
+    for i, (command, output) in enumerate(calls_and_outputs):
+        db.execute("INSERT INTO messages(session_id,role,tool_calls,timestamp) VALUES('s','assistant',?,?)",
+                   (json.dumps([{"id": f"c{i}", "function": {"name": "terminal", "arguments": json.dumps({"command": command})}}]), now))
+        db.execute("INSERT INTO messages(session_id,role,tool_name,tool_call_id,content,timestamp) VALUES('s','tool','terminal',?,?,?)",
+                   (f"c{i}", json.dumps({"output": output, "exit_code": 0, "error": None}), now))
+    db.commit()
+    db.close()
+
+
+def make_ledger(home: Path, rows):
+    life = home / "workspace" / "life-engine"
+    life.mkdir(parents=True, exist_ok=True)
+    db = sqlite3.connect(life / "ledger.sqlite3")
+    db.execute("CREATE TABLE opps(key TEXT PRIMARY KEY, state TEXT NOT NULL, autonomy TEXT, surface_at TEXT, urgency TEXT,"
+               " action_class TEXT, payload TEXT NOT NULL, sources TEXT NOT NULL, first_seen REAL, updated REAL)")
+    for key, state, payload, first_seen, updated in rows:
+        db.execute("INSERT INTO opps(key,state,payload,sources,first_seen,updated) VALUES(?,?,?,'[]',?,?)",
+                   (key, state, json.dumps(payload), first_seen, updated))
+    db.commit()
+    db.close()
+
+
+# -- the first tapback -------------------------------------------------------------------------------------------
+
+def test_eyes_lands_at_once_and_does_not_hold_up_the_turn(tmp_path):
+    a, calls = adapter(tmp_path, slow=0.5)
+
+    async def run():
+        ev = event(a, "Find me two dinner spots near the office for Friday")
+        t0 = time.monotonic()
+        await a.on_processing_start(ev)
+        started = time.monotonic() - t0
+        await asyncio.sleep(0.6)
+        return started
+    started = asyncio.run(run())
+    assert started < 0.2, f"the turn waited {started:.2f}s for the tapback"
+    assert reacts(calls) == [("/react", EYES)]
+
+
+def test_first_tapback_follows_the_users_words(tmp_path):
+    for text, first in [("thanks so much", HEART), ("Thank you 🙏", HEART), ("ok thanks", HEART), ("sounds good", OK),
+                        ("ok", OK), ("Got it", OK), ("Good morning", None), ("hey", None), ("night night", None),
+                        ("/new", None), ("/model", None), ("yes", EYES), ("send it", EYES), ("where is my order?", EYES), ("ok send it", EYES)]:
+        assert A.opening_tapback(text) == first, text
+
+
+# -- tapback-only replies ----------------------------------------------------------------------------------------
+
+def test_reply_that_only_acknowledges_goes_out_as_the_tapback(tmp_path):
+    a, calls = adapter(tmp_path)
+    asyncio.run(turn(a, "Stop the daily shoe sale emails", ["Got it, Sam."]))
+    assert texts(calls) == []
+    assert reacts(calls) == [("/react", EYES), ("/unreact", None), ("/react", OK)]
+
+
+def test_thanks_gets_a_heart_and_a_bare_youre_welcome_is_not_sent(tmp_path):
+    a, calls = adapter(tmp_path)
+    asyncio.run(turn(a, "thanks so much", ["Anytime, Sam."]))
+    assert texts(calls) == []
+    assert reacts(calls) == [("/react", HEART)]          # no churn: the first tapback was already the right one
+
+
+def test_a_question_always_gets_words(tmp_path):
+    for question in ["Did the package ship?", "can you check the order", "what time is the call"]:
+        a, calls = adapter(tmp_path)
+        asyncio.run(turn(a, question, ["Got it."]))
+        assert texts(calls) == ["Got it."], question
+
+
+def test_a_reply_with_a_fact_link_or_question_is_always_sent(tmp_path):
+    for reply in ["Got it, the cheapest is $212 on Delta.", "Will do. Want me to book it?", "Done, I sent it to Sam.",
+                  "Here: https://example.test/x", "On it."]:
+        assert not A.is_bare_ack_reply(reply), reply
+        a, calls = adapter(tmp_path)
+        asyncio.run(turn(a, "Look at flights to Austin", [reply]))
+        assert texts(calls) == [reply]
+
+
+def test_only_when_nothing_else_went_out_this_turn(tmp_path):
+    a, calls = adapter(tmp_path)
+
+    async def run():
+        ev = event(a, "Clean up the old drafts")
+        await a.on_processing_start(ev)
+        await a.send(CHAT, "Done: 4 old drafts removed.")              # a real answer goes out as text
+        await a.send(CHAT, "Got it.")                                  # something already went out this turn: sent
+        await a.on_processing_complete(ev, ProcessingOutcome.SUCCESS)
+    asyncio.run(run())
+    assert texts(calls) == ["Done: 4 old drafts removed.", "Got it."]
+
+
+# -- the last tapback --------------------------------------------------------------------------------------------
+
+def test_a_full_text_answer_leaves_no_tapback(tmp_path):
+    a, calls = adapter(tmp_path)
+    asyncio.run(turn(a, "Find me two dinner spots near the office for Friday", ["Two picks: Rosa's at 7 or Juniper at 7:30."]))
+    assert reacts(calls) == [("/react", EYES), ("/unreact", None)]
+
+
+def test_done_only_when_the_ledger_closed_it_this_turn(tmp_path):
+    cmd = "zeus-life done bill:water-fixture"
+    out = "Closed as done: Pay the water bill"
+    make_state(tmp_path, [(cmd, out)])
+    make_ledger(tmp_path, [("bill:water-fixture", "done", {"title": "Pay the water bill"}, time.time() - 900, time.time())])
+    a, calls = adapter(tmp_path)
+    asyncio.run(turn(a, "I paid the water bill, close it out", ["Closed it."]))
+    assert reacts(calls)[-1] == ("/react", DONE)
+
+
+def test_done_words_without_the_ledger_row_never_earn_a_check(tmp_path):
+    make_state(tmp_path, [("zeus-life done bill:water-fixture", "Closed as done: Pay the water bill")])
