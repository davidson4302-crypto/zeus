+++ b/plugins/platforms/photon/sidecar/status-stickers/hermes/outcome-status.mjs
@@ -0,0 +1,420 @@
+import { homedir } from 'node:os';
+// Read the provider's own results. The observer has already admitted the original owner DM.
+import { createHash } from 'node:crypto';
+import { existsSync, readFileSync, chmodSync } from 'node:fs';
+import { basename, dirname, join } from 'node:path';
+
+const sha = text => createHash('sha256').update(text).digest('hex');
+const hex64 = /^[a-f0-9]{64}$/;
+const parse = value => { try { return JSON.parse(value); } catch { return null; } };
+const flat = value => String(value ?? '').trim().toLowerCase().replace(/\s+/g,' ');
+const time = value => typeof value === 'string' && /(?:Z|[+-]\d\d:\d\d)$/i.test(value) ? Date.parse(value) : NaN;
+
+function fromDb(DatabaseSync, file, read) {
+  if (!existsSync(file)) return;
+  let db;
+  try {
+    db = new DatabaseSync(file, {readOnly:true});
+    return read(db);
+  } catch { /* An unavailable optional receipt is never evidence. */ }
+  finally { db?.close(); }
+}
+
+function records(file, key) {
+  try {
+    const rows = parse(readFileSync(file,'utf8'))?.[key];
+    return Array.isArray(rows) ? rows : [];
+  } catch { return []; }
+}
+
+// The unified session can be recorded as "desktop" even for an authenticated Photon
+// turn. Join using the gateway's message ID, origin hash, session and message timestamp.
+function originalTurn(DatabaseSync, scope, message) {
+  const textHash = message.textHash || (typeof message.text === 'string' && sha(message.text));
+  if (!hex64.test(textHash)) return;
+  const receipt = fromDb(DatabaseSync,join(scope.profileHome,'plugin-data/zeus-scope/chat_admission.sqlite3'),db => {
+    const rows = db.prepare(`SELECT payload FROM direct_human_turns WHERE text_sha256=?
+      AND json_extract(payload,'$.platform_message_id')=? AND json_extract(payload,'$.platform')='photon'
+      AND json_extract(payload,'$.profile_home')=? AND json_extract(payload,'$.author_sha256')=?
+      AND json_extract(payload,'$.session_id')=session_id AND json_extract(payload,'$.message_timestamp')=message_timestamp`)
+      .all(textHash,message.messageGuid,scope.profileHome,sha(message.sender));
+    if (rows.length === 1) return parse(rows[0].payload);
+  });
+  if (!receipt?.turn_id || !receipt.gateway_input_owner || receipt.text_sha256 !== textHash) return;
+  return fromDb(DatabaseSync,join(scope.profileHome,'state.db'),db => {
+    const rows = db.prepare(`SELECT id,content FROM messages WHERE role='user' AND session_id=?
+      AND platform_message_id=? AND timestamp=?`).all(receipt.session_id,message.messageGuid,receipt.message_timestamp);
+    if (rows.length === 1 && typeof rows[0].content === 'string' && sha(rows[0].content) === textHash)
+      return {...rows[0], receipt};
+  });
+}
+
+function attachmentDelivery(DatabaseSync, scope, message, projectId, turn, result) {
+  const paths = [join(dirname(dirname(scope.profileHome)),'state.db'), join(scope.profileHome,'state.db')];
+  if (!turn) return;
+  const request = turn.content;
+  const namedDestination=/\b(?:send|deliver|email|forward|text|share)\b[\s\S]{0,150}?\bto\s+(?!me\b|my (?:phone|inbox)\b|this (?:chat|thread)\b)(?:an? |the )?[\p{L}\d+@]/iu;
+  const explicitNumbers=[...request.matchAll(/\bto\s+(\+[1-9]\d{6,14})\b/gi)].map(m=>m[1]);
+  const destinations=new Set([message.chatGuid]);
+  if (namedDestination.test(request)) {
+    if (explicitNumbers.length===1) {
+      destinations.clear();
+      destinations.add(explicitNumbers[0]);destinations.add('any;-;'+explicitNumbers[0]);
+    } else if (!/\b(?:copy me|send me (?:a|the) copy)\b/i.test(request)) return;
+  }
+  const requestedNames = [...new Set((request.match(/[\w.-]+\.(?:pdf|xlsx?|docx?|pptx?|csv|zip|png|jpe?g|heic|mp[34]|mov|txt|md|json)\b/gi) || []).map(flat))];
+  const delivered=new Set(), pending=new Set();
+  const rows=paths.flatMap(path=>fromDb(DatabaseSync,path,db=>db.prepare(`SELECT state,provider_id,artifact_path,artifact_sha256,created_at,json_extract(route_json,'$.chat_id') AS chat_id FROM outbound_attempts
+      WHERE kind='/send-attachment' AND json_extract(route_json,'$.platform')='photon'
+      AND json_extract(route_json,'$.mode')='imessage' AND json_extract(route_json,'$.runtime_profile')=?
+      AND json_extract(route_json,'$.transport_profile')=? AND json_extract(route_json,'$.transport_identity')=?
+      AND json_extract(route_json,'$.source_message_id')=?`)
+      .all(scope.profile,scope.profile,projectId,message.messageGuid)) || []);
+  for (const row of rows) {
+    if (!destinations.has(row.chat_id) || !row.artifact_path || !hex64.test(row.artifact_sha256)) continue;
+    const name=flat(basename(row.artifact_path));
+    if (requestedNames.length && !requestedNames.includes(name)) continue;
+    const receipts=row.provider_id && paths.flatMap(path=>fromDb(DatabaseSync,path,db=>db.prepare(`
+      SELECT state,observed_at FROM outbound_receipts WHERE platform='photon' AND transport_profile=?
+        AND provider_id=? AND observed_at>=? ORDER BY observed_at DESC`).all(scope.profile,row.provider_id,row.created_at)) || []);
+    if (row.provider_id && (['delivered','read'].includes(row.state) || receipts.some(r=>['delivered','read'].includes(r.state))))
+      delivered.add(name);
+    else if (['pending','accepted','sent','uncertain'].includes(row.state) && !(receipts || []).some(r=>r.state==='failed'))
+      pending.add(name);
+  }
+  if (delivered.size && requestedNames.every(name=>delivered.has(name))) result.labels.add('file_delivered');
+  if ([...pending].some(name=>!delivered.has(name))) result.tracking=true;
+}
+
+// Pair a trusted terminal tool invocation with its actual native result within this one turn.
+// Commands are inspected only. No shell command from the conversation is ever executed.
+function shellResults(DatabaseSync, scope, turn) {
+  return fromDb(DatabaseSync,join(scope.profileHome,'state.db'),db => {
+    const rows = db.prepare(`SELECT role,tool_calls,tool_call_id,tool_name,content FROM messages
+      WHERE session_id=? AND id>? AND id<COALESCE((SELECT MIN(id) FROM messages
+      WHERE session_id=? AND role='user' AND id>?),9223372036854775807)
+      AND ((role='assistant' AND (tool_calls LIKE '%remindctl%' OR tool_calls LIKE '%' || ? || '%')) OR (role='tool' AND tool_name='terminal' AND length(content)<100000)) ORDER BY id`).all(turn.receipt.session_id,turn.id,turn.receipt.session_id,turn.id,lifeCliName);
+    const pending = new Map(), results = [];
+    for (const row of rows) {
+      if (row.role === 'assistant') {
+        const calls = parse(row.tool_calls);
+        for (const call of Array.isArray(calls) ? calls : []) {
+          if (call?.function?.name !== 'terminal' || !call.id) continue;
+          const args = typeof call.function.arguments === 'string' ? parse(call.function.arguments) : call.function.arguments;
+          if (typeof args?.command === 'string') pending.set(call.id,args.command.trim());
+        }
+      } else if (row.tool_name === 'terminal' && pending.has(row.tool_call_id)) {
+        const body = parse(row.content);
+        const command = pending.get(row.tool_call_id);
+        pending.delete(row.tool_call_id);
+        if (body?.exit_code === 0 && !body.error && typeof body.output === 'string') results.push({command,output:body.output.trim()});
+      }
+    }
+    return results;
+  }) || [];
+}
+
+// The life-engine command (PHOTON_LIFE_CLI, default zeus-life), bare or from ~/.local/bin.
+const lifeCliName = /^[A-Za-z0-9_.-]+$/.test(process.env.PHOTON_LIFE_CLI || '') ? process.env.PHOTON_LIFE_CLI : 'zeus-life';
+const lifeCli = '(?:' + homedir().replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + '/\\.local/bin/|~/\\.local/bin/)?' +
+  lifeCliName.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
+const reminderCmd = new RegExp('^' + lifeCli + ' reminder [\'"]?([a-zA-Z0-9_:#.~/-]+)[\'"]?$');
+// The owner's home time zone (PHOTON_STICKER_TZ), else this machine's.
+const localClock = new Intl.DateTimeFormat('en-US',{timeZone:process.env.PHOTON_STICKER_TZ||Intl.DateTimeFormat().resolvedOptions().timeZone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23',weekday:'long'});
+function localParts(instant) {
+  return Object.fromEntries(localClock.formatToParts(instant).map(p => [p.type,p.value]));
+}
+
+function requestedTime(text, due, created) {
+  if (!Number.isFinite(due) || !Number.isFinite(created) || due < created) return false;
+  const isos = text.match(/\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?(?:Z|[+-]\d\d:\d\d)/gi);
+  if (isos) return isos.length === 1 && Date.parse(isos[0]) === due;
+  const relative = /\bin (\d+) (minutes?|hours?)\b/i.exec(text);
+  if (relative) {
+    const minutes = Number(relative[1]) * (/hour/i.test(relative[2]) ? 60 : 1);
+    return Math.abs(due - created - minutes * 60000) < 60000;
+  }
+  const matches = [...text.matchAll(/\b(1[0-2]|0?[1-9])(?::([0-5]\d))?\s*([ap])\.?m\.?\b/gi)];
+  if (matches.length !== 1 || /\b(?:UTC|GMT|EST|EDT|CST|CDT|MST|MDT|eastern|central|mountain)\b/i.test(text)) return false;
+  const [,hour,minute,period] = matches[0], parts = localParts(due);
+  if (Number(parts.hour) !== Number(hour)%12 + (period.toLowerCase()==='p'?12:0) || Number(parts.minute)!==Number(minute || 0)) return false;
+  const dayOf = p => Date.UTC(Number(p.year),Number(p.month)-1,Number(p.day));
+  const delta = (dayOf(parts)-dayOf(localParts(created)))/86400000;
+  const date = /\b(\d{4})-(\d\d)-(\d\d)\b/.exec(text);
+  if (date) return date[1]===parts.year && date[2]===parts.month && date[3]===parts.day;
+  if (/\btomorrow\b/i.test(text)) return delta === 1;
+  if (/\b(today|tonight)\b/i.test(text)) return delta === 0;
+  const day = /\b(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/i.exec(text);
+  return day ? flat(day[1]) === flat(parts.weekday) && delta >= 0 && delta <= 7 : false;
+}
+
+// Both commands must be pure remindctl invocations from the same native tool turn.
+// Require the same full EventKit ID, title and due time on the separate read.
+function directAppleReminder(turn,calls) {
+  const created=new Map();
+  for (const {command,output} of calls) {
+    if (/[;&|`$<>\\\n]/.test(command) || !/^(?:\/opt\/homebrew\/bin\/)?remindctl (?:add|info) /.test(command) ||
+        !/(?:^|\s)(?:--json|-j|--format json)(?:\s|$)/.test(command)) continue;
+    const body=parse(output), r=Array.isArray(body) && body.length===1 ? body[0] : body;
+    if (!r?.id || !/^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/i.test(r.id) ||
+        typeof r.title!=='string' || !r.title || r.isCompleted!==false || !Number.isFinite(time(r.dueDate)) ||
+        !flat(turn.content).includes(flat(r.title)) || !requestedTime(turn.content,time(r.dueDate),turn.receipt.message_timestamp*1000)) continue;
+    if (/remindctl add /.test(command)) created.set(r.id,r);
+    else {
+      const prior=created.get(r.id);
+      const target=/remindctl info ([a-f0-9-]+)(?:\s|$)/i.exec(command)?.[1];
+      if (prior && flat(target)===flat(r.id) && prior.title===r.title && time(prior.dueDate)===time(r.dueDate)) return true;
+    }
+  }
+  return false;
+}
+
+function reminderSet(DatabaseSync, ledger, turn, calls) {
+  for (const {command,output} of calls) {
+    const match = reminderCmd.exec(command);
+    if (!match || !/^(?:Set and read back:|It is there:)/.test(output)) continue;
+    const row = fromDb(DatabaseSync,ledger,db => db.prepare('SELECT payload FROM opps WHERE key=?').get(match[1]));
+    const p = parse(row?.payload), spec=p?.research?.reminder, seen=spec?.read_back;
+    if (!p?.approved?.owners_words || spec?.state!=='created' || !seen?.id || !spec.title || seen.title!==spec.title ||
+        !output.includes(seen.title) || !output.includes(seen.due) || !(spec.claimed_at>=turn.receipt.message_timestamp)) continue;
+    if (!Number.isFinite(time(spec.due)) || Math.abs(time(spec.due)-time(seen.due))>=90000 || !Number.isFinite(time(seen.due))) continue;
+    if (flat(turn.content).includes(flat(spec.title)) &&
+        requestedTime(turn.content,time(spec.due),turn.receipt.message_timestamp*1000)) return true;
+    // An explicit yes can approve a particular prepared reminder. Require the recorded
+    // approval from this turn and the same key on both native commands.
+    if (flat(turn.content)===flat(p.approved.owners_words) && /^\s*(yes|approved|go ahead|do it|please do)\b/i.test(turn.content) &&
+        p.approved.at>=turn.receipt.message_timestamp && p.approved.at<=spec.claimed_at &&
+        calls.some(c => {
+          const prefix = new RegExp('^'+lifeCli+' approve ([a-zA-Z0-9_:#.~/-]+) (["\'])([^"\'\\\\`$]+)\\2$').exec(c.command);
+          return prefix?.[1]===match[1] && flat(prefix[3])===flat(turn.content) && c.output.includes('reminder '+match[1]);
+        })) return true;
+  }
+  return false;
+}
+
+function flightRefs(DatabaseSync,scope,message,turn,trips) {
+  const rows = fromDb(DatabaseSync,join(scope.profileHome,'plugin-data/zeus-work/state.sqlite3'),db =>
+    db.prepare("SELECT payload FROM work WHERE json_extract(payload,'$.source.message_id')=? AND json_extract(payload,'$.source.chat_id')=?")
+      .all(message.messageGuid,message.chatGuid)) || [];
+  const bindings = new Set();
+  for (const row of rows) {
+    const work=parse(row.payload), s=work?.source, b=work?.flight_monitor;
+    if (work?.owner!==scope.profile || work.derivation || work.state==='stopped' || s?.origin!=='direct' ||
+        s.profile!==scope.profile || s.profile_home!==scope.profileHome || s.transport_profile!==scope.profile ||
+        s.platform!=='photon' || s.author_id!==message.sender || s.session_id!==turn.receipt.session_id ||
+        s.turn_id!==turn.receipt.turn_id || typeof s.text!=='string' || sha(s.text)!==turn.receipt.text_sha256 ||
+        s.receipt?.turn_id!==turn.receipt.turn_id || s.receipt?.session_id!==turn.receipt.session_id ||
+        s.receipt?.platform_message_id!==message.messageGuid || s.receipt?.author_sha256!==turn.receipt.author_sha256) continue;
+    const ref=work.external_ref;
+    for (const trip of trips) {
+      if (!/^t-[a-f0-9]{8}$/.test(trip?.id) || !Array.isArray(trip.legs) || !trip.legs.length) continue;
+      const legs=trip.legs.map(leg=>[leg.date,leg.ident,leg.origin,leg.dest]);
+      if (legs.some(leg=>leg.some(v=>!v))) continue;
+      // Match the native registered_trip() canonical itinerary digest (sorted keys).
+      const digest=sha(JSON.stringify({airport:trip.pickup?.airport ?? null,asked:[...(trip.asked || [])].sort(),legs,own_trip:trip.own_trip,who:trip.who}));
+      if ((ref?.system==='life-flight' && ref.id===trip.id) || (b?.id===trip.id && b.revision===work.revision &&
+          !!work.scope_hash && b.scope_hash===work.scope_hash && b.itinerary_hash===digest)) bindings.add(trip.id);
+    }
+  }
+  return bindings;
+}
+
+const flightAdd = new RegExp('^'+lifeCli+' flight add ');
+function flightStatuses(DatabaseSync,scope,message,turn,calls,life,ledger,result) {
+  const trips=records(join(life,'flights.json'),'trips'), ids=flightRefs(DatabaseSync,scope,message,turn,trips);
+  for (const {command,output} of calls) {
+    if (!flightAdd.test(command) || /[;&|`$<>\n]/.test(command)) continue;
+    const match=/^(?:Watching|Already watching that trip) \((t-[a-f0-9]{8})\):/.exec(output);
+    const trip=match && trips.find(t=>t.id===match[1]);
+    if (trip?.legs?.length && trip.legs.every(l=>command.includes([l.ident,l.date,l.origin,l.dest].join(':')))) ids.add(trip.id);
+  }
+  for (const trip of trips.filter(t=>ids.has(t?.id) && t.state!=='stopped')) {
+    if (trip.state==='watching') result.tracking=true;
+    const notices=fromDb(DatabaseSync,ledger,db=>db.prepare(`SELECT o.payload,b.text FROM opps o
+      JOIN note_items n ON n.opp=o.key JOIN outbox b ON b.key=n.note WHERE o.key GLOB ?
+      AND o.first_seen>=? AND json_extract(o.payload,'$.flight_trip')=? AND json_extract(o.payload,'$._source')='monitor'
+      AND json_extract(o.payload,'$.moment')='schedule_change' AND b.mode='live' AND b.state='sent'`)
+      .all('flight:'+trip.id+':*',turn.receipt.message_timestamp,trip.id)) || [];
+    for (const row of notices) {
+      const p=parse(row.payload), notice=p?.packet?.headline, fp=p?.fingerprint;
+      if (!p?.packet?.verbatim || !notice || !trip.fingerprints?.includes(fp) || !row.text?.includes(notice)) continue;
+      if (!trip.legs.some(l=>['sched_out','sched_in'].some(side=>Number.isFinite(time(l[side])) &&
+          new RegExp('^'+String(l.ident).toLowerCase().replace(/[^a-z0-9]/g,'')+'-'+l.date+'-'+side+'-\\d{8}$').test(fp)))) continue;
+      const clocks=/new scheduled (?:departure|arrival): (\d{1,2}:\d{2}[ap]m), was (\d{1,2}:\d{2}[ap]m)\./i.exec(notice);
+      if (clocks && clocks[1]!==clocks[2]) result.labels.add('time_changed');
+    }
+  }
+}
+
+const watchAdd = new RegExp('^'+lifeCli+' watch add ');
+function boundWatch(w,turn,calls) {
+  if (!w || !/^w-[0-9a-f]{8}$/.test(w.id) || w.by!=='chat' || !['web','chrome'].includes(w.read?.kind) ||
+      !/^https?:\/\//.test(w.read.url) || w.state==='stopped') return false;
+  const urls=turn.content.match(/https?:\/\/[^\s<>"']+/gi) || [];
+  if (urls.length && !urls.some(url=>url.replace(/[.,)]$/,'')===w.read.url)) return false;
+  if (w.words_checked===true && w.message_id===turn.id && flat(w.words) && flat(turn.content).includes(flat(w.words))) return true;
+  return calls.some(({command,output})=>watchAdd.test(command) && !/[;&|`$<>\n]/.test(command) &&
+    command.includes(w.read.url) && (output.match(/^Watch: (w-[0-9a-f]{8})\./m)?.[1]===w.id ||
+      output.startsWith('That is already being watched: ['+w.id+']')));
+}
+
+function offer(w,value) {
+  if (typeof value!=='string' || w.part?.present) return;
+  const context=flat([w.part?.page_has,w.part?.line,w.part?.pattern,value].filter(Boolean).join(' '));
+  // A marketplace URL alone cannot identify a seller. Require seller and item/offer
+  // context that the page reader actually matched, never the model's watch description.
+  if (!/\b(?:sold by|seller\s*[:=]|merchant\s*[:=])\s*[\p{L}\d]/u.test(context)) return;
+  if (!/(?:\b(?:sku|product|item|offer|model)\b[\s:#/-]+[\p{L}\d]|\/(?:products?|items?|dp|ip)\/[^/?#]+)/u.test(context+' '+w.read.url)) return;
+  const amount=/(?:\b(?:USD|CAD|AUD|EUR|GBP)\s*|[$£€])(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d{2})?(?![.,\d])/gi;
+  const hits=[...value.matchAll(amount)];
+  if (hits.length!==1) return;
+  const token=hits[0][0], number=token.match(/[\d,.]+$/)[0], currency=token.slice(0,token.length-number.length).trim().toUpperCase();
+  const minor=Math.round(Number(number.replaceAll(',',''))*100);
+  if (!Number.isSafeInteger(minor) || minor<0) return;
+  return {minor,currency,terms:flat(value.replace(amount,'[price]'))};
+}
+
+function lower(a,b) {
+  return !!(a && b && a.currency===b.currency && a.terms===b.terms && b.minor<a.minor);
+}
+
+// A watch's native pending comparison is consumed by the noticer. Keep the last
+// verified price locally so a restart around that handoff retains adjacent reads.
+// No message text, URL or price description is saved in the sticker ledger.
+function priceHistory(DatabaseSync,scope,key,w,next,dropped) {
+  if (!scope.ledgerDir || !existsSync(scope.ledgerDir)) return dropped;
+  let db;
+  try {
+    const file=join(scope.ledgerDir,'observed-watch-readings.sqlite3');
+    db=new DatabaseSync(file);
+    chmodSync(file,0o600);
+    db.exec(`PRAGMA busy_timeout=500; CREATE TABLE IF NOT EXISTS readings (
+      binding TEXT PRIMARY KEY, change_no INTEGER NOT NULL, observed REAL NOT NULL,
+      amount INTEGER NOT NULL,currency TEXT NOT NULL,terms_hash TEXT NOT NULL,earned INTEGER NOT NULL)`);
+    db.exec('BEGIN IMMEDIATE');
+    const old=db.prepare('SELECT * FROM readings WHERE binding=?').get(key);
+    const at=time(w.value_at), terms=sha(next.terms);
+    let earned=Boolean(old?.earned) || dropped;
+    if (old && at>old.observed && w.changes===old.change_no+1 &&
+        next.currency===old.currency && terms===old.terms_hash && next.minor<old.amount) earned=true;
+    if (!old || (at>=old.observed && w.changes>=old.change_no && (at>old.observed || w.changes>old.change_no || Number(earned)!==old.earned))) {
+      db.prepare('INSERT OR REPLACE INTO readings VALUES(?,?,?,?,?,?,?)')
+        .run(key,w.changes,at,next.minor,next.currency,terms,Number(earned));
+    }
+    db.exec('COMMIT');
+    return earned;
+  } catch { return dropped; }
+  finally { db?.close(); }
+}
+
+function fieldTime(value) {
+  if (typeof value!=='string') return;
+  const stamps=[...value.matchAll(/\b\d{4}-\d\d-\d\d[T ]\d\d:\d\d(?::\d\d)?(?:[+-]\d\d:\d\d|Z)\b/gi)];
+  if (stamps.length!==1 || !Number.isFinite(time(stamps[0][0]))) return;
+  return {at:time(stamps[0][0]),stamp:stamps[0][0],rest:flat(value.replace(stamps[0][0],'[time]'))};
+}
+
+// Keep an adjacent pair until the existing notification lane sends its explanatory
+// text. This survives the watch noticer clearing "pending" before a delayed send.
+function scheduleComparison(DatabaseSync,scope,key,w,current,prior,after) {
+  const nativePair=prior && prior.rest===current.rest && prior.at!==current.at ?
+    {old:prior.stamp,now:current.stamp,n:w.changes} : null;
+  if (!scope.ledgerDir || !existsSync(scope.ledgerDir)) return nativePair;
+  let db;
+  try {
+    const file=join(scope.ledgerDir,'observed-watch-readings.sqlite3');
+    db=new DatabaseSync(file);
+    chmodSync(file,0o600);
+    db.exec(`PRAGMA busy_timeout=500; CREATE TABLE IF NOT EXISTS schedule_readings (
+      binding TEXT PRIMARY KEY, n INTEGER NOT NULL, observed REAL NOT NULL,
+      stamp TEXT NOT NULL, field TEXT NOT NULL, prior_stamp TEXT)`);
+    db.exec('BEGIN IMMEDIATE');
+    const last=db.prepare('SELECT * FROM schedule_readings WHERE binding=?').get(key);
+    const at=time(w.value_at), field=sha(current.rest);
+    let pair=nativePair;
+    if (last && last.n===w.changes && last.stamp===current.stamp && last.field===field && last.prior_stamp)
+      pair={old:last.prior_stamp,now:current.stamp,n:w.changes};
+    if (last && w.changes===last.n+1 && at>last.observed && at>=after && last.field===field && time(last.stamp)!==current.at)
+      pair={old:last.stamp,now:current.stamp,n:w.changes};
+    if (!last || (at>=last.observed && w.changes>=last.n && (at>last.observed || last.n!==w.changes || (!last.prior_stamp && pair)))) {
+      db.prepare('INSERT OR REPLACE INTO schedule_readings VALUES(?,?,?,?,?,?)')
+        .run(key,w.changes,at,current.stamp,field,pair?.old || null);
+    }
+    db.exec('COMMIT');
+    return pair;
+  } catch { return nativePair; }
+  finally { db?.close(); }
+}
+
+function statesBothTimes(text,pair) {
+  if (typeof text!=='string') return false;
+  if (text.includes(pair.old) && text.includes(pair.now)) return true;
+  // A clock-only explanation is sufficient for a same-date move in the same zone.
+  // Same-clock moves on different dates must name both dates.
+  const date=stamp=>stamp.slice(0,10);
+  if (date(pair.old)!==date(pair.now) || pair.old.slice(19)!==pair.now.slice(19)) return false;
+  const clock=stamp=>{
+    const hour=Number(stamp.slice(11,13));
+    return (hour%12 || 12)+':'+stamp.slice(14,16)+(hour<12?'am':'pm');
+  };
+  const a=clock(pair.old), b=clock(pair.now), normalized=flat(text).replace(/\s+([ap])\.?m\.?/g,'$1m');
+  const mentions=token=>new RegExp('(?:^|[^0-9:])'+token+'\\b').test(normalized);
+  return a!==b && mentions(a) && mentions(b);
+}
+
+function watchStatuses(DatabaseSync,scope,message,turn,calls,life,ledger,result) {
+  if (!existsSync(join(life,'watches-on'))) return;
+  for (const w of records(join(life,'watches.json'),'watches')) {
+    if (!boundWatch(w,turn,calls) || (!w.part?.pattern && !w.part?.line && !w.part?.block)) continue;
+    const isPrice=/\b(price|cost|cheaper|discount|drops?|deal)\b/i.test(turn.content);
+    const requestedPage=(turn.content.match(/https?:\/\/[^\s<>"']+/gi) || []).some(url=>url.replace(/[.,)]$/,'')===w.read.url);
+    const operatorPage=w.monitor?.trust==='source' && !!w.monitor.key;
+    const isTime=(requestedPage || operatorPage) && w.monitor?.trust!=='tracker' &&
+      /\b(time|delivery|appointment|arrival|depart(?:ure)?|flight|shipment|schedule|eta)\b/i.test(turn.content) &&
+      /\b(?:appointment|flight|delivery|tracking|shipment|booking)\s*(?:id|number|no\.?|#|:)\s*[:#-]?\s*[\w-]+/i.test([w.part.page_has,w.part.line,w.part.pattern].join(' '));
+    const current=isPrice && offer(w,w.value), newTime=isTime && fieldTime(w.value);
+    if (w.state==='watching' && (current || newTime)) result.tracking=true;
+    if (w.fails!==0 || !Number.isSafeInteger(w.changes) || !Number.isFinite(time(w.value_at)) ||
+        !Number.isFinite(time(w.checked_at)) || time(w.checked_at)<time(w.value_at)) continue;
+    const p=w.pending;
+    const adjacent=p && !p.was_reported && p.n===w.changes && (w.raised?.n || 0)+1===p.n &&
+      p.now===w.value && time(p.at)===time(w.value_at) && time(p.at)>=turn.receipt.message_timestamp*1000;
+    const key=sha(JSON.stringify([scope.profile,message.chatGuid,message.messageGuid,w.id,w.created_at,w.read,w.part]));
+    if (current) {
+      if (priceHistory(DatabaseSync,scope,key,w,current,Boolean(adjacent && lower(offer(w,p.was),current)))) result.labels.add('price_dropped');
+    }
+    if (newTime) {
+      const pair=scheduleComparison(DatabaseSync,scope,key,w,newTime,adjacent && fieldTime(p.was),turn.receipt.message_timestamp*1000);
+      if (!pair) continue;
+      const eventId='watch:'+w.id+':'+pair.n;
+      const sent=fromDb(DatabaseSync,ledger,db=>db.prepare(`SELECT b.text FROM opps o
+        JOIN note_items n ON n.opp=o.key JOIN outbox b ON b.key=n.note WHERE b.mode='live' AND b.state='sent'
+        AND EXISTS (SELECT 1 FROM json_each(o.sources) WHERE value=?)`).all(eventId)) || [];
+      if (sent.some(({text})=>statesBothTimes(text,pair))) result.labels.add('time_changed');
+    }
+  }
+}
+
+export function readOutcomeReceipt(DatabaseSync,scope,message,projectId) {
+  const result={labels:new Set(),tracking:false};
+  if (!scope?.profileHome || !scope.profile || !message?.messageGuid || !message.chatGuid || !message.sender || !projectId)
+    return {statuses:[],tracking:false};
+  const turn=originalTurn(DatabaseSync,scope,message);
+  attachmentDelivery(DatabaseSync,scope,message,projectId,turn,result);
+  if (turn) {
+    const life=join(scope.profileHome,'workspace/life-engine'), ledger=join(life,'ledger.sqlite3');
+    const calls=shellResults(DatabaseSync,scope,turn);
+    if (directAppleReminder(turn,calls) || reminderSet(DatabaseSync,ledger,turn,calls)) result.labels.add('reminder_set');
+    if (existsSync(join(life,'research-flow-on'))) flightStatuses(DatabaseSync,scope,message,turn,calls,life,ledger,result);
+    watchStatuses(DatabaseSync,scope,message,turn,calls,life,ledger,result);
+  }
+  return {statuses:[...result.labels],tracking:result.tracking};
+}
+
+export function readOutcomeStatuses(DatabaseSync,scope,message,projectId) {
+  return readOutcomeReceipt(DatabaseSync,scope,message,projectId).statuses;
+}
+
+export function readOutcomeTracking(DatabaseSync,scope,message,projectId) {
+  return readOutcomeReceipt(DatabaseSync,scope,message,projectId).tracking;
+}
