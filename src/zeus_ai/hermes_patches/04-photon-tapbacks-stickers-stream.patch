@@ -0,0 +1,24 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+function localClock(time, zone) {
+  const parts = new Intl.DateTimeFormat('en-CA', {timeZone:zone, year:'numeric', month:'2-digit',
+    day:'2-digit', hour:'2-digit', hourCycle:'h23'}).formatToParts(time);
+  const values = Object.fromEntries(parts.map(v=>[v.type,v.value]));
+  return {date:[values.year,values.month,values.day].join('-'),hour:Number(values.hour)};
+}
+
+export function canPlaceNow(scope, original, time) {
+  // A current reply to the owner's own fresh message can continue during quiet hours.
+  const age=time-new Date(original.createdAt).getTime();
+  if(age>=0 && age<3600000) return true;
+  let clock=localClock(time,scope.timeZone||Intl.DateTimeFormat().resolvedOptions().timeZone);
+  try {
+    const rule=JSON.parse(readFileSync(join(scope.profileHome,'workspace/life-engine/owner-zone.json'),'utf8'));
+    const destination=localClock(time,rule.zone);
+    if ((!rule.from||destination.date>=rule.from) && (!rule.until||destination.date<=rule.until)) clock=destination;
+  } catch { /* No valid travel clock: the configured home time zone applies. */ }
+  // Allowed from quiet-hours end (default 9) until quiet-hours start (default 21), on the owner's clock.
+  const end=Number.isInteger(scope.quietEnd)?scope.quietEnd:9, start=Number.isInteger(scope.quietStart)?scope.quietStart:21;
+  return end<=start ? clock.hour>=end && clock.hour<start : clock.hour>=end || clock.hour<start;
+}
