+// Called only for an original message yielded by this running Photon connection.
+// Hermes's existing authenticated inbox is authoritative for admission and reply state.
+import { createHash } from 'node:crypto';
+import { existsSync } from 'node:fs';
+import { basename, dirname, join } from 'node:path';
+import { setTimeout as wait } from 'node:timers/promises';
+import { readBookingState } from './booking.mjs';
+import { createStickerGate } from '../src/pilot.mjs';
+import { placeStatusSticker } from '../src/placement.mjs';
+
+const sha256 = value => createHash('sha256').update(value).digest('hex');
+const control = /^\s*(?:\/|(?:stop|cancel|never mind|nevermind|do nothing)\b)/i;
+
+function sameSource(source, message, profile) {
+  return source?.platform === 'photon' && source.profile === profile &&
+    source.chat_type === 'dm' && source.chat_id === message.chatGuid &&
+    source.user_id === message.sender && source.message_id === message.messageGuid;
+}
+
+function artifactStatus(db, message, scope) {
+  // Only verified work belonging to this exact authenticated message may name an outcome.
+  const rows = db.prepare(`SELECT payload FROM work
+    WHERE json_extract(payload, '$.source.message_id') = ?
+      AND json_extract(payload, '$.source.chat_id') = ?`).all(message.messageGuid, message.chatGuid);
+  for (const row of rows) {
+    const work = JSON.parse(row.payload);
+    const source = work.source;
+    if (work.owner !== scope.profile || work.derivation || source.origin !== 'direct' ||
+        source.profile !== scope.profile || source.transport_profile !== scope.profile ||
+        source.profile_home !== scope.profileHome || source.author_id !== message.sender ||
+        source.platform !== 'photon' || !source.turn_id || !source.session_id ||
+        source.receipt?.kind !== 'direct' || source.receipt?.human_author_claimed !== true ||
+        !['completed', 'output_ready'].includes(work.state) ||
+        !Array.isArray(work.criteria) || !work.criteria.length) continue;
+    const verified = work.criteria.every(criterion => {
+      const evidence = work.evidence?.[criterion.id];
+      return evidence?.passed === true && evidence.revision === work.revision &&
+        evidence.bytes > 0 && /^[a-f0-9]{64}$/.test(evidence.sha256) &&
+        typeof criterion.artifact === 'string' &&
+        evidence.path === join(scope.profileHome, 'plugin-data', 'zeus-work', 'artifacts', work.id, criterion.artifact);
+    });
+    if (!verified) continue;
+    for (const criterion of work.criteria) {
+      const name = basename(criterion.artifact).toLowerCase().split('.')[0];
+      if (/(^|[-_ ])summary($|[-_ ])/.test(name)) return 'summary_ready';
+      if (/(^|[-_ ])draft($|[-_ ])/.test(name)) return 'draft_ready';
+    }
+  }
+  return null;
+}
+
+function readDatabase(DatabaseSync, path, read) {
+  if (!existsSync(path)) return null;
+  const db = new DatabaseSync(path, { readOnly: true });
+  try {
+    db.exec('PRAGMA query_only=ON');
+    return read(db);
+  } finally {
+    db.close();
+  }
+}
+
+function legacyState(row, message, profile) {
+  if (!row || row.status === 'queued') return 'pending';
+  if (!['running', 'completed'].includes(row.status)) return 'closed';
+  const stamped = JSON.parse(row.immutable);
+  const sender = stamped.sender;
+  const route = row.native_context && JSON.parse(row.native_context).reply_route;
+  if (!route) return 'pending'; // begin_event and bind_event_route are separate transactions.
+  if (sender?.authenticated !== true || sender.is_bot !== false || sender.platform !== 'photon' ||
+      sender.profile !== profile || sender.transport_profile !== profile || sender.user_id !== message.sender ||
+      stamped.profile !== profile || !sameSource(stamped.reply_route?.source, message, profile) ||
+      route.message_id !== message.messageGuid || route.profile !== profile ||
+      route.transport_profile !== profile || !sameSource(route.source, message, profile)) return 'closed';
+  if (row.status === 'running') return 'running';
+  const receipt = JSON.parse(row.result || '{}');
+  return receipt.native_processing_outcome === 'success' && receipt.delivery_attempted === true &&
+    receipt.provider_acknowledged === true && receipt.transport_profile === profile &&
+    sameSource(receipt.actual_reply_source, message, profile) ? 'replied' : 'closed';
+}
+
+function currentState(DatabaseSync, message, scope, projectId) {
+  // Direct-human receipts are generated inside the actual agent turn, after gateway admission.
+  // Never substitute the newest user turn or a guessed session for the incoming provider ID.
+  const answer = readDatabase(DatabaseSync, join(scope.profileHome, 'plugin-data', 'zeus-scope', 'chat_admission.sqlite3'), db => {
+    const row = db.prepare(`SELECT payload, session_id, message_timestamp FROM direct_human_turns
+      WHERE json_extract(payload, '$.platform_message_id')=? AND json_extract(payload, '$.platform')='photon'
+      AND json_extract(payload, '$.author_sha256')=? AND json_extract(payload, '$.profile_home')=? LIMIT 1`)
+      .get(message.messageGuid, sha256(message.sender), scope.profileHome);
+    if (!row) return null;
+    const verified = JSON.parse(row.payload);
+    if (!verified.turn_id || !verified.gateway_input_owner || !verified.session_id || verified.session_id !== row.session_id) return null;
+    const newer = db.prepare(`SELECT 1 FROM direct_human_turns WHERE session_id=? AND message_timestamp>? LIMIT 1`)
+      .get(row.session_id, row.message_timestamp);
+    return { newer: Boolean(newer) };
+  });
+  if (!answer) return 'pending';
+  const dbPaths = [join(dirname(dirname(scope.profileHome)), 'state.db'), join(scope.profileHome, 'state.db')];
+  for (const path of dbPaths) {
+    const status = readDatabase(DatabaseSync, path, db => {
+      const present = db.prepare("SELECT 1 FROM sqlite_schema WHERE name='outbound_attempts'").get();
+      if (!present) return null;
+      // These are final sends with an obligation, not acknowledgments, typing or progress events.
+      return db.prepare(`SELECT state, provider_id FROM outbound_attempts
+        WHERE json_extract(route_json,'$.platform')='photon' AND json_extract(route_json,'$.mode')='imessage'
+          AND json_extract(route_json,'$.runtime_profile')=? AND json_extract(route_json,'$.transport_profile')=?
+          AND json_extract(route_json,'$.transport_identity')=? AND json_extract(route_json,'$.chat_id')=?
+          AND json_extract(route_json,'$.source_message_id')=? AND kind='/send'
+          AND length(json_extract(route_json,'$.obligation_id'))>0
+          AND json_extract(route_json,'$.operation_id')=json_extract(route_json,'$.obligation_id')
+        ORDER BY updated_at DESC LIMIT 1`).get(scope.profile, scope.profile, projectId, message.chatGuid, message.messageGuid);
+    });
+    if (status) {
+      if (status.provider_id && ['accepted','sent','delivered','read'].includes(status.state)) return 'replied';
+      if (['uncertain','failed','not_attempted'].includes(status.state)) return 'closed';
+    }
+  }
+  return answer.newer ? 'closed' : 'running';
+}
+
+export function readHermesState(DatabaseSync, message, scope, projectId) {
+  const profile = scope.profile;
+  const root = join(scope.profileHome, 'plugin-data');
+  const key = 'gateway:' + sha256(JSON.stringify([
+    'photon', profile, profile, '', message.chatGuid, '', message.messageGuid,
+  ]));
+  const row = readDatabase(DatabaseSync, join(root, 'company-harness', 'workflow.sqlite3'),
+    db => db.prepare('SELECT immutable, native_context, status, result FROM inbox WHERE event_key=? AND profile=?')
+      .get(key, profile));
+  // A current native human entry can vouch for work on installations with no company-inbox admission.
+  return row ? legacyState(row, message, profile) : currentState(DatabaseSync, message, scope, projectId);
+}
+
+export async function readHermesReceipt(message, scope, projectId) {
+  const { DatabaseSync } = await import('node:sqlite');
+  const root = join(scope.profileHome, 'plugin-data');
+  const state = readHermesState(DatabaseSync, message, scope, projectId);
+  if (state !== 'running' && state !== 'replied') return { state };
+  // A booking needs a typed provider confirmation tied to this approved request.
+  const booking = readBookingState(DatabaseSync, scope, message);
+  if (booking === 'booked') return { state, artifact: 'booked' };
+  // The work ledger is optional. Its absence cannot erase a native reply acknowledgment.
+  let artifact = null;
+  try {
+    artifact = readDatabase(DatabaseSync, join(root, 'zeus-work', 'state.sqlite3'),
+      db => artifactStatus(db, message, scope));
+  } catch {
+    // A transient read or differing plugin schema gives no authority for an artifact label.
+  }
+  return booking === 'pending' ? { state, artifact, pendingBooking: true } : { state, artifact };
+}
+
+export function fromProvider(space, incoming) {
+  if (incoming?.direction !== 'inbound' || incoming.platform !== 'imessage' ||
+      space?.type !== 'dm' || incoming.space?.type !== 'dm' || incoming.space.id !== space.id ||
+      incoming.space.phone !== space.phone || !space.phone || !incoming.id || !incoming.timestamp) return null;
+  let content = incoming.content;
+  if (content?.type === 'reply') content = content.content;
+  if (content?.type !== 'text' || typeof content.text !== 'string' ||
+      !content.text.trim() || control.test(content.text)) return null;
+  return {
+    phone: space.phone, chatGuid: space.id, messageGuid: incoming.id,
+    sender: incoming.sender?.id, spaceType: space.type, direction: incoming.direction,
+    text: content.text, createdAt: incoming.timestamp,
+  };
+}
+
+export function createHermesStickers({ app, projectId, port, gate = createStickerGate({ projectId, port }),
+    place = placeStatusSticker, read = readHermesReceipt, now = Date.now,
+    pause = ms => wait(ms, undefined, { ref: false }), workingAfter = 10000 }) {
+  const active = new Set();
+  async function observe(space, incoming) {
+    const message = fromProvider(space, incoming);
+    if (!message) return;
+    const key = JSON.stringify([message.chatGuid, message.messageGuid]);
+    if (active.has(key)) return;
+    active.add(key);
+    try {
+      const scope = await gate.admit(message);
+      if (!scope) return;
+      const started = now();
+      const shown = new Set();
+      for (;;) {
+        const receipt = await read(message, scope, projectId);
+        if (receipt.state === 'closed') return;
+        let status = receipt.artifact;
+        if (!status && receipt.state === 'replied' && (scope.mode === 'pilot' || shown.size)) status = 'reply_ready';
+        if (!status && receipt.state === 'running' && !shown.size && now() - started >= workingAfter) status = 'working';
+        if (status && !shown.has(status)) {
+          const still = await gate.admit(message);
+          if (!still || still.profileHome !== scope.profileHome || still.ledgerDir !== scope.ledgerDir ||
+              still.mode !== scope.mode) return;
+          shown.add(status);
+          await place({ app, projectId, ledgerDir: scope.ledgerDir, target: message, status,
+            singleSticker: scope.mode === 'pilot' });
+          if (scope.mode === 'pilot') return;
+        }
+        // A settled reply or vanished admission ends this live observation.
+        if ((receipt.state === 'replied' && !receipt.pendingBooking) || now() - started >= 30 * 60_000 || (receipt.state === 'pending' && now() - started >= 60_000)) return;
+        await pause(1500);
+        if (!(await gate.admit(message))) return;
+      }
+    } catch (error) {
+      console.warn('Photon status sticker observation stopped:', error?.code || error?.name || 'error');
+    } finally {
+      active.delete(key);
+    }
+  }
+  return observe;
+}
