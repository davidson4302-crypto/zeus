diff --git a/plugins/platforms/photon/sidecar/refreshable-stream.mjs b/plugins/platforms/photon/sidecar/refreshable-stream.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..88ec193493e8877d4d447fdea8533419ebc37652
--- /dev/null
+++ b/plugins/platforms/photon/sidecar/refreshable-stream.mjs
@@ -0,0 +1,44 @@
+// Refresh only the provider subscription. The SDK client and HTTP sends stay live.
+export function createRefreshableStream(openSource) {
+  let source = null;
+  let refreshing = false;
+  let closed = false;
+  return {
+    async refresh() {
+      if (closed || !source || refreshing) return false;
+      refreshing = true;
+      try {
+        // SDK streams expose close(), which releases a pending next() and
+        // cancels the underlying gRPC subscriptions and line observers.
+        await source.close();
+        return true;
+      } catch (error) {
+        refreshing = false;
+        throw error;
+      }
+    },
+    async close() {
+      closed = true;
+      await source?.close();
+    },
+    async *[Symbol.asyncIterator]() {
+      try {
+        do {
+          refreshing = false;
+          source = openSource();
+          for await (const value of source) yield value;
+        } while (refreshing && !closed);
+      } finally {
+        closed = true;
+        await source?.close();
+      }
+    },
+  };
+}
+
+// A completed unary read proves connectivity, not that a quiet stream is dead.
+// Ignore probes whose observation was superseded by traffic during the read.
+export async function refreshQuietStream({ stream, observedInboundAt, lastInboundAt }) {
+  if (!stream || observedInboundAt !== lastInboundAt) return false;
+  return stream.refresh();
+}
