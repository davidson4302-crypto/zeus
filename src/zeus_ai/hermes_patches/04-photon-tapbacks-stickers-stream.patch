@@ -0,0 +1,42 @@
+// Only an expressly configured project loads the new observers. The existing
+// sidecar remains usable even when the optional release cannot start.
+import {readFile} from 'node:fs/promises';
+import {homedir} from 'node:os';
+import {dirname, isAbsolute, join} from 'node:path';
+
+// The profile's Hermes home: `profileHome` in the settings file, else ~/.hermes/profiles/<profile>.
+function profileHome(cfg) {
+  return typeof cfg.profileHome==='string' && isAbsolute(cfg.profileHome) && cfg.profileHome.endsWith('/'+cfg.profile)
+    ? cfg.profileHome : join(homedir(),'.hermes','profiles',cfg.profile);
+}
+
+export async function selectStickers({app,projectId,port,prior,configDir=join(homedir(),'.config','photon-status-stickers')}) {
+  const old=()=>({observe:prior({app,projectId,port}),health:async()=>({revision:1})});
+  if(!/^[a-z0-9-]+$/i.test(projectId)||!Number.isInteger(port)) return old();
+  const cfgPath=join(configDir,projectId+'-'+port+'.json');
+  async function settings(){
+    try {
+      const config=JSON.parse(await readFile(cfgPath,'utf8'));
+      if(config.projectId===projectId && config.port===port && config.revision===2 &&
+         typeof config.profile==='string' && /^[a-z0-9-]{1,100}$/i.test(config.profile) &&
+         /^\+[1-9]\d{6,14}$/.test(config.owner) &&
+         Number.isFinite(Date.parse(config.armedAt))) return config;
+    } catch { /* A removed or invalid setting disables the optional feature. */ }
+    return null;
+  }
+  const cfg=await settings();
+  if(!cfg) return old();
+  try {
+    const {createActiveStickers}=await import('./active-stickers.mjs');
+    const {createStickerGate}=await import('../src/pilot.mjs');
+    const scope={profile:cfg.profile,profileHome:profileHome(cfg),ledgerDir:join(configDir,'receipts',projectId+'-'+port),
+      timeZone:typeof cfg.timeZone==='string'?cfg.timeZone:undefined,
+      quietStart:Number.isInteger(cfg.quietStart)?cfg.quietStart:undefined,
+      quietEnd:Number.isInteger(cfg.quietEnd)?cfg.quietEnd:undefined};
+    const active=createActiveStickers({app,projectId,scope,settings,gate:createStickerGate({projectId,port,configDir,profilesDir:dirname(profileHome(cfg))})});
+    return {observe:active.observe,onReceipt:active.onReceipt,health:async()=>({...active.health(),mode:(await settings())?.mode??'disabled'})};
+  } catch {
+    // A failed revision must never fall back to a different sticker policy.
+    return {observe:async()=>{},health:async()=>({revision:2,mode:'unavailable',labels:[],lastIssue:'startup'})};
+  }
+}
