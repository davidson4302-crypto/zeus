+async def test_configured_quiet_recipient_stays_scoped_across_two_homes(tmp_path):
+    """Load the real YAML/config path A to B to A without cross-home suppression."""
+    import json
+    from gateway.config import Platform, load_gateway_config
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+    a, b = tmp_path / "quiet", tmp_path / "ordinary"
+    for home, ignored in [(a, ["+15551234567"]), (b, [])]:
+        home.mkdir()
+        (home / "config.yaml").write_text(json.dumps({"platforms": {"photon": {
+            "enabled": True, "extra": {"reactions": True, "automatic_reactions_ignored_users": ignored}
+        }}}))
+    for home, expected in [(a, []), (b, [_EYES, _THUMBS_UP]), (a, [])]:
+        token = set_hermes_home_override(home)
+        try:
+            config = load_gateway_config()
+            adapter = PhotonAdapter(config.platforms[Platform("photon")])
+            calls = _capture_sidecar(adapter)
+            event = _message_event(adapter)
+            await adapter.on_processing_start(event)
+            await adapter.on_processing_complete(event, ProcessingOutcome.SUCCESS)
+            assert [body["emoji"] for path, body in calls if path == "/react"] == expected
+        finally:
+            reset_hermes_home_override(token)
