diff --git a/plugins/platforms/photon/sidecar/status-stickers/src/pilot.mjs b/plugins/platforms/photon/sidecar/status-stickers/src/pilot.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0f09a8e06192256931e1c605350c079dc221d424
--- /dev/null
+++ b/plugins/platforms/photon/sidecar/status-stickers/src/pilot.mjs
@@ -0,0 +1,69 @@
+import { link, mkdir, readFile, unlink, writeFile } from "node:fs/promises";
+import { createHash, randomUUID } from "node:crypto";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+const projectPattern = /^[a-z0-9-]{1,100}$/i;
+const digest = value => createHash("sha256").update(value).digest("hex");
+
+// Publish a fully written first claim. Concurrent arrivals and restarts see the same winner.
+async function bindMessage(path, hash) {
+  try {
+    return await readFile(path, "utf8") === hash;
+  } catch (error) {
+    if (error.code !== "ENOENT") throw error;
+  }
+  const temporary = path + "." + randomUUID();
+  try {
+    await writeFile(temporary, hash, { flag: "wx", mode: 0o600 });
+    try {
+      await link(temporary, path);
+    } catch (error) {
+      if (error.code !== "EEXIST") throw error;
+    }
+  } finally {
+    await unlink(temporary).catch(() => {});
+  }
+  return await readFile(path, "utf8") === hash;
+}
+
+function matchesOwner(message, config) {
+  const owner = config.owner;
+  return typeof owner === "string" && /^\+[1-9]\d{6,14}$/.test(owner) &&
+    message.sender === owner && message.spaceType === "dm" && message.direction === "inbound" &&
+    ["any", "iMessage"].some(service => message.chatGuid === service + ";-;" + owner) &&
+    Boolean(message.phone) && (!config.phone || message.phone === config.phone);
+}
+
+export function createStickerGate({ projectId, port, configDir = join(homedir(), ".config", "photon-status-stickers"), profilesDir = join(homedir(), ".hermes", "profiles"), now = Date.now }) {
+  const scoped = projectPattern.test(projectId || "") && Number.isInteger(Number(port)) && Number(port) > 0 && Number(port) <= 65535;
+  const file = scoped ? join(configDir, projectId + "-" + Number(port) + ".json") : null;
+  return {
+    async admit(message) {
+      if (!file || !message || typeof message.messageGuid !== "string" || !message.messageGuid) return null;
+      try {
+        const config = JSON.parse(await readFile(file, "utf8"));
+        if (config.projectId !== projectId || config.port !== Number(port) || !matchesOwner(message, config)) return null;
+        const issued = Date.parse(config.armedAt);
+        const sent = new Date(message.createdAt).valueOf();
+        const clock = now();
+        if (!Number.isFinite(issued) || !Number.isFinite(sent) || sent < issued || sent > clock + 5000) return null;
+        if (typeof config.profile !== "string" || !projectPattern.test(config.profile)) return null;
+        const ledgerDir = join(configDir, "receipts", projectId + "-" + config.port);
+        const scope = { profile: config.profile, profileHome: join(profilesDir, config.profile), ledgerDir };
+        if (config.mode === "enabled") return { mode: "enabled", ...scope };
+        if (config.mode !== "pilot" || !projectPattern.test(config.runId || "")) return null;
+        const expires = Date.parse(config.expiresAt);
+        if (!Number.isFinite(expires) || expires <= issued || clock >= expires || sent >= expires) return null;
+        if (typeof message.text !== "string" || !config.phrase || message.text.trim() !== config.phrase) return null;
+        await mkdir(ledgerDir, { recursive: true, mode: 0o700 });
+        const claim = join(ledgerDir, "pilot-" + config.runId + ".claim");
+        if (!await bindMessage(claim, digest(message.chatGuid + "\0" + message.messageGuid))) return null;
+        return { mode: "pilot", ...scope };
+      } catch {
+        // Missing opt-in, an unreadable ledger, and invalid configuration all leave ordinary replies alone.
+        return null;
+      }
+    }
+  };
+}
diff --git a/plugins/platforms/photon/sidecar/status-stickers/src/placement.mjs b/plugins/platforms/photon/sidecar/status-stickers/src/placement.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..416be2aa14ab945e860b9094438c6de2a5e866b1
--- /dev/null
+++ b/plugins/platforms/photon/sidecar/status-stickers/src/placement.mjs
@@ -0,0 +1,166 @@
+// Place a status badge on a real inbound iMessage through the current Spectrum
+// session. The caller decides when a milestone is true. Sticker failures are
+// deliberately returned as data so they cannot break a normal reply.
+import { createHash } from "node:crypto";
+import { access, mkdir, open, readFile, rename, writeFile } from "node:fs/promises";
+import { isAbsolute, join } from "node:path";
+
+export const approvedStatuses = Object.freeze([
+  "need_your_ok", "waiting_on_reply", "pick_one", "reminder_set",
+  "file_delivered", "price_dropped", "time_changed",
+]);
+
+export const stickerStatuses = Object.freeze([
+  ...approvedStatuses,
+  "working", "researching", "draft_ready", "booked", "summary_ready", "reply_ready",
+]);
+
+function parseMessageId(id) {
+  if (typeof id !== "string" || id.length > 512 || !id || /[\s\x00-\x1f]/u.test(id)) return null;
+  if (!id.startsWith("p:")) return { guid: id };
+  // Spectrum flattens multipart messages into p:<index>/<parent native guid>.
+  const part = /^p:(\d+)\/([^/]+)$/u.exec(id);
+  if (!part) return null;
+  const partIndex = Number(part[1]);
+  return Number.isSafeInteger(partIndex) && partIndex <= 2147483647
+    ? { guid: part[2], partIndex } : null;
+}
+
+function canonicalChat(id) {
+  if (typeof id !== "string" || id.trim() !== id || !/^(?:any|iMessage);[-+];[^\x00-\x1f]+$/u.test(id)) return null;
+  // These SDKs require "any;" on the write API. The iMessage service alias
+  // seen in native chat metadata changes only that prefix, never the address.
+  return id.replace(/^iMessage;/u, "any;");
+}
+
+function matchesTarget(message, guid, chatGuid) {
+  return message?.guid === guid && message.isFromMe === false &&
+    Array.isArray(message.chatGuids) && message.chatGuids.some(id => canonicalChat(id) === chatGuid);
+}
+
+function hasSticker(message, guid, chatGuid, attachmentGuid, partIndex) {
+  return matchesTarget(message, guid, chatGuid) && !message.sendErrorCode &&
+    Array.isArray(message.placedStickers) && message.placedStickers.some((entry) =>
+      entry.isFromMe === true && typeof entry.messageGuid === "string" && entry.messageGuid.length > 0 &&
+      (entry.targetPartIndex ?? 0) === (partIndex ?? 0) &&
+      (entry.sticker?.guid === attachmentGuid || entry.sticker?.originalGuid === attachmentGuid));
+}
+
+// Exclusive creation across independent processes. Sync both file and parent
+// before issuing the first write to the provider. A partial claim is still a
+// claim after a crash, even if the separate receipt was never written.
+async function claim(directory, file, value) {
+  const fd = await open(file, "wx", 0o600);
+  try {
+    await fd.writeFile(JSON.stringify(value) + "\n");
+    await fd.sync();
+  } finally {
+    await fd.close();
+  }
+  const parent = await open(directory, "r");
+  try { await parent.sync(); } finally { await parent.close(); }
+}
+
+function result(state, reason) {
+  return reason ? { state, reason } : { state };
+}
+
+export async function placeStatusSticker({ app, projectId, ledgerDir, target, status, signal, singleSticker = false } = {}) {
+  const phone = target?.phone;
+  const chatGuid = canonicalChat(target?.chatGuid);
+  const message = parseMessageId(target?.messageGuid);
+  if (!stickerStatuses.includes(status) || !message || typeof projectId !== "string" || !projectId ||
+      typeof phone !== "string" || !phone || !chatGuid ||
+      typeof ledgerDir !== "string" || !isAbsolute(ledgerDir)) {
+    return result("skipped", "invalid_input");
+  }
+  const stopped = () => signal?.aborted === true;
+  if (stopped()) return result("skipped", "cancelled");
+  let claimPath;
+  let placementStarted = false;
+  let ownsClaim = false;
+  let step = "provider";
+  let attachmentGuid;
+  let association;
+  try {
+    // Both installed Spectrum versions expose the initialized provider here.
+    // Reuse its authenticated, token-refreshing client. A missing or ambiguous
+    // match is never replaced by a random client or the project's default line.
+    const entries = app?.__internal?.platforms?.get("imessage")?.client;
+    const matches = Array.isArray(entries) ? entries.filter(entry => entry.phone === phone) : [];
+    if (matches.length !== 1) return result("skipped", "unmatched_line");
+    const client = matches[0].client;
+    if (typeof client?.messages?.get !== "function" || typeof client.messages.placeSticker !== "function" ||
+        typeof client.attachments?.upload !== "function") return result("skipped", "unsupported_client");
+
+    const hash = createHash("sha256").update(JSON.stringify([projectId, phone, chatGuid,
+      message.guid, message.partIndex ?? 0, singleSticker ? "single" : status])).digest("hex");
+    // RFC 9562 version 8 UUID: stable for this milestone on this bubble/line.
+    const uuid = [hash.slice(0, 8), hash.slice(8, 12), "8" + hash.slice(13, 16),
+      ((parseInt(hash[16], 16) & 3) | 8).toString(16) + hash.slice(17, 20), hash.slice(20, 32)].join("-");
+    claimPath = join(ledgerDir, hash + ".claim");
+    step = "ledger";
+    await mkdir(ledgerDir, { recursive: true, mode: 0o700 });
+    try {
+      await access(claimPath);
+      return result("already_attempted");
+    } catch (e) { if (e.code !== "ENOENT") throw e; }
+
+    step = "target_lookup";
+    const source = await client.messages.get(message.guid);
+    if (!matchesTarget(source, message.guid, chatGuid) || source.dateRetracted ||
+        ["SMS", "RCS"].includes(source.sender?.service)) return result("skipped", "unverified_target");
+    if (stopped()) return result("skipped", "cancelled");
+
+    step = "asset";
+    const data = await readFile(new URL("./art/" + status + ".png", import.meta.url));
+    step = "ledger";
+    try {
+      await claim(ledgerDir, claimPath, { status, clientMessageId: uuid, createdAt: new Date().toISOString() });
+      ownsClaim = true;
+    } catch (e) {
+      if (e.code === "EEXIST") return result("already_attempted");
+      throw e;
+    }
+    if (stopped()) return result("skipped", "cancelled");
+
+    step = "upload";
+    const upload = await client.attachments.upload({ fileName: status + ".png", data });
+    attachmentGuid = upload?.attachment?.guid;
+    if (typeof attachmentGuid !== "string" || !attachmentGuid) return result("failed", "invalid_upload");
+    if (stopped()) return result("skipped", "cancelled");
+
+    const options = { clientMessageId: uuid };
+    if (message.partIndex !== undefined) options.partIndex = message.partIndex;
+    const placement = { x: 0.72, y: 0.92, scale: 0.72 };
+    placementStarted = true;
+    try {
+      const receipt = await client.messages.placeSticker(chatGuid, message.guid, attachmentGuid, placement, options);
+      if (hasSticker(receipt, message.guid, chatGuid, attachmentGuid, message.partIndex)) {
+        association = result("recorded");
+      }
+    } catch {
+      // A timed-out placement may already exist. Only read the exact target.
+    }
+    if (!association) {
+      const readback = await client.messages.get(message.guid);
+      association = hasSticker(readback, message.guid, chatGuid, attachmentGuid, message.partIndex)
+        ? result("recorded") : result("uncertain", "association_unconfirmed");
+    }
+    return association;
+  } catch {
+    return placementStarted ? result("uncertain", "association_unconfirmed") : result("failed", step);
+  } finally {
+    if (ownsClaim) {
+      // An application receipt describes provider association, never device
+      // visibility. The immutable .claim remains authoritative on every exit.
+      const evidence = { status, targetMessageGuid: message.guid, partIndex: message.partIndex ?? 0, attachmentGuid, checkedAt: new Date().toISOString(),
+        state: association?.state ?? (placementStarted ? "uncertain" : stopped() ? "cancelled" : "failed") };
+      const receiptPath = claimPath + ".json";
+      try {
+        await writeFile(receiptPath + ".tmp", JSON.stringify(evidence) + "\n", { mode: 0o600 });
+        await rename(receiptPath + ".tmp", receiptPath);
+      } catch { /* A missing receipt never releases a claim. */ }
+    }
+  }
+}
