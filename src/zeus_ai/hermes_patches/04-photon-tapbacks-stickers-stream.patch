+# Link bubbles. A link that ends its line goes out as its own message, so iMessage shows the preview card (a URL inside
+# prose never gets one; a URL-only send goes through richlink()). Off unless the profile's photon extra sets
+# ``link_bubbles: true``. Never cuts a word: every character of the reply is sent, in order; only the link is lifted
+# out of the line it ended. A link in the middle of a sentence, inside quotation marks (a draft the user will send)
+# or inside a code block stays where it is.
+_LINK_BUBBLES_MAX = 3            # more links than this: the rest stay in the text where they are
+_LINK_AT_END = re.compile(
+    r"^(?P<lead>.*?)(?:\[(?P<label>[^\]\n]+)\]\((?P<md>https?://[^\s)]+)\)|\(?(?P<url>https?://[^\s)'\"<>]+?)\)?)"
+    r"(?P<tail>[.,;:!?]*)\s*$", re.IGNORECASE)
+_QUOTE_SPAN = re.compile(r"“[^“”]*”|\"[^\"\n]*\"")
+
+
+def _link_bubbles(text: str) -> List[str]:
+    """The reply as the bubbles it goes out in: prose, then each line-ending link on its own, then the prose after it.
+    [text] when there is nothing to lift out. Pure and deterministic: a redelivery splits the same way, so the durable
+    journal recognises every bubble that already went."""
+    if not text or "```" in text or _url_only_candidate(text) or not _SIDECAR_URL_RE.search(text):
+        return [text]
+    quoted = [(m.start(), m.end()) for m in _QUOTE_SPAN.finditer(text)]
+    bubbles: List[str] = []
+    prose: List[str] = []
+    lifted, pos = 0, 0
+    for line in text.split("\n"):
+        start, pos = pos, pos + len(line) + 1
+        m = _LINK_AT_END.match(line) if lifted < _LINK_BUBBLES_MAX else None
+        url = (m.group("md") or m.group("url")) if m else None
+        at = start + (m.start("md") if m and m.group("md") else m.start("url") if m else 0)
+        if not url or _url_only_candidate(url) is None or any(a < at < b for a, b in quoted):
+            prose.append(line)
+            continue
+        lead = m.group("lead").rstrip()
+        if m.group("label"):
+            lead = (lead + " " + m.group("label")).strip()
+        if re.fullmatch(r"[-•*\s]*", lead):
+            lead = ""
+        if lead:
+            prose.append(lead)
+        chunk = "\n".join(prose).strip()
+        if chunk:
+            bubbles.append(re.sub(r"\n{3,}", "\n\n", chunk))
+        bubbles.append(url)
+        prose, lifted = [], lifted + 1
+    chunk = "\n".join(prose).strip()
+    if chunk:
+        bubbles.append(re.sub(r"\n{3,}", "\n\n", chunk))
+    return bubbles if lifted else [text]
+
