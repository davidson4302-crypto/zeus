+    admitted INTEGER NOT NULL DEFAULT 0, attempted TEXT NOT NULL DEFAULT '[]', due REAL NOT NULL);
+    CREATE INDEX IF NOT EXISTS due_observations ON observed(due)`);
+  const add = db.prepare('INSERT OR IGNORE INTO observed(id,activation,target,first_seen,due) VALUES(?,?,?,?,?)');
+  const ready = db.prepare('SELECT * FROM observed WHERE due<=? ORDER BY due LIMIT 12');
+  const remove = db.prepare('DELETE FROM observed WHERE id=?');
+  const update = db.prepare('UPDATE observed SET admitted=?,attempted=?,due=? WHERE id=?');
+  const postpone = db.prepare('UPDATE observed SET due=? WHERE id=?');
+  const nextDue = db.prepare('SELECT min(due) AS due FROM observed');
+  let timer;
+  let running = false;
+  let fastUntil = 0;
+  let closed = false;
+  let lastIssue = null;
+
+  function schedule(delay) {
+    if (closed) return;
+    if (timer) clearTimer(timer);
+    timer = setTimer(() => {
+      timer = undefined;
+      void drain();
+    }, delay);
+    timer?.unref?.();
+  }
+
+  // The gateway commits receipts asynchronously after the native event. Recheck
+  // the owner's pending work promptly, then read the authoritative store as usual.
+  const wakeChat = db.prepare(`UPDATE observed SET due=min(due,?)
+    WHERE json_extract(target,'$.phone')=?
+    AND json_extract(target,'$.chatGuid') IN (?,?)`);
+  function onReceipt(space) {
+    if (closed || space?.type !== 'dm' || !space.phone) return;
+    const ownerDM = /^(?:any|iMessage);-;(\+[1-9]\d{6,14})$/.exec(space.id || '');
+    if (!ownerDM) return;
+    try {
+      const at = now();
+      if (wakeChat.run(at, space.phone, 'any;-;' + ownerDM[1], 'iMessage;-;' + ownerDM[1]).changes) {
+        fastUntil = at + 10000;
+        schedule(25);
+      }
+    } catch {
+      lastIssue = 'receipt_wake';
+    }
+  }
+
+  async function authorized(message, activation) {
+    const config = await settings();
+    return config?.mode === 'enabled' && config.armedAt === activation && await gate.admit(message);
+  }
+
+  async function examine(row) {
+    const message = JSON.parse(row.target);
+    if (!await authorized(message, row.activation)) {
+      remove.run(row.id);
+      return;
+    }
+
+    const receipt = await read(message, scope, projectId, Boolean(row.admitted));
+    const attempted = new Set(JSON.parse(row.attempted));
+    let deferred = false;
+    for (const status of receipt.statuses) {
+      if (!approvedStatuses.includes(status) || attempted.has(status)) continue;
+      if (!canPlaceNow(scope, message, now())) {
+        deferred = true;
+        continue;
+      }
+      if (!await authorized(message, row.activation)) {
+        remove.run(row.id);
+        return;
+      }
+      const placed = await place({ app, projectId, ledgerDir: scope.ledgerDir, target: message, status });
+      // Only an unsuccessful pre-placement read can be retried. The transport
+      // keeps its durable claim across restarts, including after an uncertain write.
+      if (placed.state === 'failed' && placed.reason === 'target_lookup') throw new Error('target_lookup');
+      attempted.add(status);
+    }
+
+    const finished = receipt.state === 'replied' || receipt.state === 'closed';
+    if (finished && !deferred && !receipt.tracking) {
+      remove.run(row.id);
+      return;
+    }
+    let delay = 1000;
+    if (deferred) delay = minute;
+    else if (now() >= fastUntil && now() - row.first_seen >= minute) {
+      delay = receipt.admitted ? 5000 : minute;
+    }
+    update.run(receipt.admitted ? 1 : 0, JSON.stringify([...attempted]), now() + delay, row.id);
+  }
+
+  async function drain() {
+    if (closed || running) return;
+    running = true;
+    try {
+      for (const row of ready.all(now())) {
+        if (closed) break;
+        try {
+          await examine(row);
+        } catch {
+          lastIssue = 'receipt_check';
+          postpone.run(now() + 15000, row.id);
+        }
+      }
+    } catch {
+      lastIssue = 'queue_read';
+    } finally {
+      running = false;
+      if (closed) {
+        db.close();
+      } else {
+        try {
+          const next = nextDue.get().due;
+          if (next !== null) schedule(Math.max(50, Math.min(minute, next - now())));
+        } catch {
+          lastIssue = 'queue_read';
+          schedule(15000);
+        }
+      }
+    }
+  }
+
+  async function observe(space, incoming) {
+    try {
+      const message = fromProvider(space, incoming);
+      if (closed || !message) return;
+      const config = await settings();
+      if (config?.mode !== 'enabled' || !await gate.admit(message)) return;
+      const id = hash(JSON.stringify([message.phone, message.chatGuid, message.messageGuid]));
+      // Keep the route and text hash. The original conversation stays in Hermes.
+      const { text, ...target } = message;
+      target.textHash = hash(text);
+      const at = now();
+      add.run(id, config.armedAt, JSON.stringify(target), at, at);
+      schedule(25);
+    } catch {
+      lastIssue = 'admission';
+    }
+  }
+
+  function health() {
+    const pending = db.prepare('SELECT count(*) AS n FROM observed').get().n;
+    return { revision: 2, receiptWake: true, labels: [...approvedStatuses], pending, lastIssue };
+  }
+
+  function close() {
+    if (closed) return;
+    closed = true;
+    if (timer) clearTimer(timer);
+    if (!running) db.close();
+  }
+
+  schedule(50);
+  return { observe, onReceipt, health, close, drain };
+}
diff --git a/plugins/platforms/photon/sidecar/status-stickers/hermes/approved-receipts.mjs b/plugins/platforms/photon/sidecar/status-stickers/hermes/approved-receipts.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f6656ce3aab49ced98f416ebbd334e9f198d3819
--- /dev/null
+++ b/plugins/platforms/photon/sidecar/status-stickers/hermes/approved-receipts.mjs
@@ -0,0 +1,21 @@
+// Source-authorized reads only. Reusing the native admission receipt also prevents an
+// outbound echo or unrelated shared-line event from polling another conversation's work.
+import { DatabaseSync } from 'node:sqlite';
+import { readHermesState } from './inbound.mjs';
+import { readDecisionReceipt } from './decision-status.mjs';
+import { readOutcomeReceipt } from './outcome-status.mjs';
+
+export async function readApprovedReceipts(message, scope, projectId, previouslyAdmitted = false) {
+  const state = readHermesState(DatabaseSync, message, scope, projectId);
+  const admitted = state === 'running' || state === 'replied';
+  // A previously admitted request can have a genuine downstream event after newer DMs.
+  if (!admitted && !previouslyAdmitted) return { state, statuses: [], tracking: false, admitted };
+  const decision = readDecisionReceipt(DatabaseSync, scope, message, projectId);
+  const outcome = readOutcomeReceipt(DatabaseSync, scope, message, projectId);
+  return {
+    state,
+    admitted: true,
+    tracking: decision.pending || outcome.tracking,
+    statuses: [...new Set([...decision.statuses, ...outcome.statuses])],
+  };
+}
diff --git a/plugins/platforms/photon/sidecar/status-stickers/hermes/booking.mjs b/plugins/platforms/photon/sidecar/status-stickers/hermes/booking.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..36d2727742604a51477d8621d4366be768b98765
--- /dev/null
+++ b/plugins/platforms/photon/sidecar/status-stickers/hermes/booking.mjs
@@ -0,0 +1,40 @@
+import { existsSync } from "node:fs";
+import { join } from "node:path";
+
+// The reservation adapter records the approving user row ID in state.owner.
+// Only the adapter's provider-confirmation step can turn that reservation into "confirmed".
+export function readBookingState(DatabaseSync, scope, message) {
+  const reservations = join(scope.profileHome, "state", "reservations", "reservations.sqlite3");
+  if (!existsSync(reservations)) return null;
+  const state = join(scope.profileHome, "state.db");
+  if (!existsSync(state)) return null;
+  let history;
+  let bookings;
+  try {
+    history = new DatabaseSync(state, { readOnly:true });
+    const owners = history.prepare(`SELECT m.id FROM messages m JOIN sessions s ON s.id=m.session_id
+      WHERE m.platform_message_id=? AND m.role='user' AND s.source='photon'
+        AND s.chat_type='dm' AND s.user_id=? LIMIT 2`).all(message.messageGuid, message.sender);
+    if (owners.length !== 1) return null;
+    bookings = new DatabaseSync(reservations, { readOnly:true });
+    const rows = bookings.prepare(`SELECT status,
+          json_extract(state,'$.checkpoint') AS checkpoint,
+          json_extract(state,'$.receipt') AS receipt,
+          json_extract(state,'$.expires') AS expires
+        FROM reservations WHERE kind IN ('table','hotel')
+          AND status IN ('armed','awaiting_receipt','confirmed')
+          AND json_extract(state,'$.owner')=? LIMIT 2`).all(String(owners[0].id));
+    if (rows.length !== 1) return null;
+    const row = rows[0];
+    if (row.status === "confirmed") {
+      return row.checkpoint === "provider confirmation" && typeof row.receipt === "string" &&
+        row.receipt.trim().length > 0 ? "booked" : null;
+    }
+    return row.status === "awaiting_receipt" || Number(row.expires) > Date.now()/1000 ? "pending" : null;
+  } catch {
+    return null;
+  } finally {
+    bookings?.close();
+    history?.close();
+  }
+}
diff --git a/plugins/platforms/photon/sidecar/status-stickers/hermes/decision-status.mjs b/plugins/platforms/photon/sidecar/status-stickers/hermes/decision-status.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c73b3054dabeb855d17c67f87692be656b2bda93
--- /dev/null
+++ b/plugins/platforms/photon/sidecar/status-stickers/hermes/decision-status.mjs
@@ -0,0 +1,220 @@
+// All reads use existing runtime records. Nothing here sends, acknowledges or retries work.
+import { createHash } from 'node:crypto';
+import { existsSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+
+const hash = value => createHash('sha256').update(value).digest('hex');
+const parse = value => { try { return JSON.parse(value); } catch { return null; } };
+const sameArray = (a, b) => Array.isArray(a) && Array.isArray(b) &&
+  a.length === b.length && a.every((v, i) => v === b[i]);
+
+function read(DatabaseSync, path, fn) {
+  if (!existsSync(path)) return null;
+  let db;
+  try {
+    db = new DatabaseSync(path, { readOnly: true });
+    db.exec('PRAGMA query_only=ON');
+    return fn(db);
+  } catch {
+    return null; // Missing optional table, different schema, or transient read.
+  } finally {
+    db?.close();
+  }
+}
+
+const action = '(?:send|book|reserve|submit|publish|post|share|email|forward|place|purchase|buy|pay|cancel|schedule|order|approve|sign|delete|update|apply|proceed)';
+const approval = new RegExp('^(?:(?:should|may|can|shall) I |(?:do you )?want me to |would you like me to )' + action + '\\b.{0,180}\\?$', 'i');
+const approveRequest = /^(?:(?:can|could|will|would) you (?:please )?approve|do you approve) (?:the |my |this |sending |booking |posting |publishing |submitting |sharing |paying |placing |canceling |cancelling |deleting |applying )[^?]{1,160}\?$/i;
+const choiceAsk = /^(?:which (?:one|option|slot|time|date|day|version|route|plan|design|color|do you prefer|would you (?:prefer|like)|works (?:best )?for you)\b|(?:would|do) you prefer\b|(?:can|could) you (?:pick|choose)\b|(?:please )?(?:choose|pick) (?:one|between)\b)/i;
+const actionOr = /\b(?:or not|yes or no|now or later)\b/i;
+// An agent may ask for the owner's OK as a statement, never a question: "Say yes and I'll send it.", "Say yes and
+// it goes." It comes right after the prepared draft and is sometimes followed by an unrelated "Also, ..." paragraph,
+// so the question forms above do not catch it.
+const sayYes = /^(?:just )?say yes,? and (?:i(?:'ll| will) [a-z]+\b[^?"\u201c\u201d`]{0,140}|it goes(?: out)?)[.!]?[\s\u2600-\u27bf\ufe0f\u{1f300}-\u{1faff}]*$/iu;
+
+function decisionQuestion(content) {
+  if (typeof content !== 'string' || content.length > 40000) return null;
+  const body = content.trim();
+  // The closing sentence of any paragraph. Checked before the draft and example exclusions below, because
+  // this ask comes right after the draft it is about ("Here's the draft: ... Say yes and I'll send it."); a line
+  // inside a quoted draft or a quote block starts with its quote mark and cannot match.
+  const closers = body.split(/\n/).map(line => line.trim().replaceAll('\u2019', "'").split(/(?<=[.!?])\s+(?=[A-Z])/).at(-1));
+  if (closers.some(s => sayYes.test(s) && !/\b(?:if|when|unless|or|hypothetically|pretend|for example)\b/i.test(s))) return 'need_your_ok';
+  // Exclude examples, quoted correspondence and drafts as a source of instructions for the owner.
+  if (/(?:```|^\s*>|(?:^|[.!?]\s+)(?:example|sample|draft (?:text|message|email)|suggested wording|you (?:could|can) (?:say|write|ask)|(?:here(?:'s| is) )?(?:what|the text) (?:to|you (?:can|could)) (?:send|say|write))\b)/im.test(body)) return null;
+  if (/(?:^|[.!?]\s+|\n)(?:(?:here['’]s|here is) (?:an? |the )?(?:example|draft|sample|quote|suggested (?:message|reply))|(?:draft|sample|example|quote|suggested reply)\s*:|(?:they|he|she|the (?:customer|client|vendor)) (?:asked|wrote|said)\s*:)/im.test(body)) return null;
+  const lines = body.split(/\n/).map(line => line.trim()).filter(Boolean);
+  const options = lines.filter(line => /^(?:[A-D][).:]|[1-4][).])\s+\S/i.test(line));
+  const distinctOptions = new Set(options.map(line => line.slice(2).trim().toLowerCase()));
+  const asks = lines.flatMap(line => line.split(/(?<=[.!?])\s+(?=[A-Z])/))
+    .filter(s => !options.includes(s));
+  const last = asks.at(-1);
+  if (!last || (!/[?]$/.test(last) && !/^(?:please )?(?:pick|choose) one[:.]?$/i.test(last)) || /["“”`]|\b(?:hypothetically|already|pretend|for example)\b/i.test(last)) return null;
+  if (choiceAsk.test(last)) {
+    const alternatives = last.replace(/[?:.]$/, '').split(/\s+or\s+/i);
+    if ((distinctOptions.size >= 2 && options.length >= 2 &&
+         new Set(options.map(line => line[0].toUpperCase())).size === options.length) ||
+        (alternatives.length === 2 && alternatives[1].trim().length > 0 && !/^(?:[a-d]|that|the other|something else|not)$/i.test(alternatives[1].trim()) &&
+         /(?:,|:|\bprefer|\bbetween)\s+\S+/i.test(alternatives[0]) && !actionOr.test(last))) return 'pick_one';
+  }
+  if (!/\b(?:or|if|when|hypothetically)\b|\b(?:say|ask|suggest|discuss) whether\b/i.test(last) &&
+      (approval.test(last) || approveRequest.test(last))) return 'need_your_ok';
+  return null;
+}
+
+function finalReply(DatabaseSync, scope, message, projectId, hermesHome) {
+  const paths = [join(hermesHome, 'state.db'), join(scope.profileHome, 'state.db')];
+  const candidates = paths.flatMap(path => read(DatabaseSync, path, db => db.prepare(`
+    SELECT attempt_id, content, state, provider_id, created_at, updated_at FROM outbound_attempts
+    WHERE kind='/send' AND json_valid(route_json) AND json_extract(route_json,'$.platform')='photon'
+      AND json_extract(route_json,'$.mode')='imessage' AND json_extract(route_json,'$.runtime_profile')=?
+      AND json_extract(route_json,'$.transport_profile')=? AND json_extract(route_json,'$.transport_identity')=?
+      AND json_extract(route_json,'$.chat_id')=? AND json_extract(route_json,'$.source_message_id')=?
+      AND length(json_extract(route_json,'$.obligation_id'))>0
+      AND json_extract(route_json,'$.obligation_id')=json_extract(route_json,'$.operation_id')
+    ORDER BY created_at DESC, updated_at DESC LIMIT 2`).all(scope.profile,scope.profile,projectId,
+      message.chatGuid,message.messageGuid)) || []);
+  candidates.sort((a,b) => b.created_at - a.created_at || b.updated_at - a.updated_at);
+  const latest = candidates[0];
+  if (!latest?.provider_id) return null;
+  // Duplicate copies of a receipt may coexist in the two native stores.
+  const copies = candidates.filter(c => c.attempt_id === latest.attempt_id && c.provider_id === latest.provider_id &&
+    c.content === latest.content);
+  // Actual Photon acknowledgments can land in the shared connection while the final send
+  // remains 'accepted' in the profile's local database. Match the provider GUID on the same transport.
+  const receipts = paths.flatMap(path => read(DatabaseSync, path, db => db.prepare(`
+    SELECT state,observed_at FROM outbound_receipts WHERE platform='photon' AND transport_profile=?
+      AND provider_id=? AND observed_at>=? ORDER BY observed_at DESC`).all(scope.profile,latest.provider_id,latest.created_at)) || []);
+  const delivered = [...copies,...receipts].some(c => c.state === 'delivered' || c.state === 'read');
+  const lastReceipt = receipts.sort((a,b) => b.observed_at - a.observed_at)[0];
+  if (!delivered && (!['sent','accepted'].includes(latest.state) || ['failed','uncertain'].includes(lastReceipt?.state))) return null;
+  return { content: latest.content, delivered };
+}
+
+// Photon turns commonly live in the profile's shared *desktop* native session. The admission
+// receipt, written by the gateway for the private human, supplies the correct session and timestamp.
+function sourceStamp(DatabaseSync, scope, message) {
+  const expectedHash = message.textHash || (typeof message.text === 'string' ? hash(message.text) : null);
+  return read(DatabaseSync, join(scope.profileHome,'plugin-data/zeus-scope/chat_admission.sqlite3'), db => {
+    const rows = db.prepare(`SELECT session_id,message_timestamp,payload FROM direct_human_turns
+      WHERE json_valid(payload) AND json_extract(payload,'$.platform_message_id')=?
+        AND json_extract(payload,'$.platform')='photon' AND json_extract(payload,'$.profile_home')=?
+        AND json_extract(payload,'$.author_sha256')=? LIMIT 2`).all(message.messageGuid,scope.profileHome,hash(message.sender));
+    if (rows.length !== 1) return rows.length ? {invalid:true} : null;
+    const r = rows[0], p = parse(r.payload);
+    if (!p.turn_id || !p.gateway_input_owner || r.session_id !== p.session_id || r.message_timestamp !== p.message_timestamp ||
+        (expectedHash && expectedHash !== p.text_sha256)) return {invalid:true};
+    const newer = db.prepare(`SELECT 1 FROM direct_human_turns WHERE session_id=? AND message_timestamp>?
+      AND json_valid(payload) AND json_extract(payload,'$.platform')='photon'
+      AND json_extract(payload,'$.profile_home')=? AND json_extract(payload,'$.author_sha256')=?
+      AND json_extract(payload,'$.session_id')=session_id
+      AND json_extract(payload,'$.message_timestamp')=message_timestamp
+      AND length(json_extract(payload,'$.gateway_input_owner'))>0 AND length(json_extract(payload,'$.turn_id'))>0
+      AND length(json_extract(payload,'$.platform_message_id'))>0 AND json_extract(payload,'$.platform_message_id')<>? LIMIT 1`)
+      .get(r.session_id,r.message_timestamp,scope.profileHome,p.author_sha256,message.messageGuid);
+    return {...p,newer:Boolean(newer)};
+  });
+}
+
+function directTurn(DatabaseSync, scope, message, stamp) {
+  return read(DatabaseSync, join(scope.profileHome,'state.db'), db => {
+    const users = stamp ? db.prepare(`SELECT m.id,m.session_id,m.timestamp FROM messages m JOIN sessions s ON s.id=m.session_id
+      WHERE m.role='user' AND m.session_id=? AND m.platform_message_id=? AND m.timestamp=? AND s.profile_name=? LIMIT 2`)
+      .all(stamp.session_id,message.messageGuid,stamp.message_timestamp,scope.profile) :
+      db.prepare(`SELECT m.id,m.session_id,m.timestamp FROM messages m JOIN sessions s ON s.id=m.session_id
+      WHERE m.role='user' AND m.platform_message_id=? AND s.source='photon' AND s.chat_type='dm' AND s.user_id=?
+      AND s.chat_id=? AND s.profile_name=? LIMIT 2`).all(message.messageGuid,message.sender,message.chatGuid,scope.profile);
+    if (users.length !== 1) return null;
+    const u = users[0];
+    const next = db.prepare("SELECT id FROM messages WHERE session_id=? AND role='user' AND id>? ORDER BY id LIMIT 1").get(u.session_id,u.id);
+    const rows = db.prepare(`SELECT id,role,tool_calls,tool_call_id,tool_name,timestamp FROM messages WHERE session_id=?
+      AND id>? AND id<? AND (tool_calls IS NOT NULL OR role='tool') ORDER BY id`).all(u.session_id,u.id,next?.id || Number.MAX_SAFE_INTEGER);
+    const calls = [];
+    for (const r of rows) {
+      if (r.role !== 'assistant') continue;
+      const items = parse(r.tool_calls);
+      if (!Array.isArray(items)) continue;
+      for (const item of items) {
+        const fn = item?.function;
+        const params = typeof fn?.arguments === 'string' ? parse(fn.arguments) : fn?.arguments;
+        // The deferred-tool entry point persists a tool_call wrapper with the real tool name
+        // on the result row. Native tools may also be called directly.
+        const requested = fn?.name === 'tool_call' ? params?.calls : [{name:fn?.name, arguments:params}];
+        if (!item?.id || !Array.isArray(requested) || requested.length !== 1) continue;
+        const {name, arguments:args} = requested[0] || {};
+        if (name !== 'agentmail_send' || !args) continue;
+        const result = rows.find(t => t.id > r.id && t.role === 'tool' && t.tool_call_id === item.id && t.tool_name === name);
+        if (result) calls.push({ name, args, start: u.timestamp, end: result.timestamp });
+      }
+    }
+    const newerPrivateUser = !stamp && db.prepare(`SELECT 1 FROM messages WHERE session_id=? AND id>?
+      AND role='user' AND length(platform_message_id)>0 AND platform_message_id<>? LIMIT 1`).get(u.session_id,u.id,message.messageGuid);
+    return { calls, newerPrivateUser:Boolean(newerPrivateUser) };
+  });
+}
+
+function mailOfTurn(DatabaseSync, scope, call) {
+  const a = call.args;
+  if (typeof a.action_id !== 'string' || !Array.isArray(a.to) || !a.to.every(v => typeof v === 'string') ||
+      typeof a.text !== 'string') return null;
+  const row = read(DatabaseSync, join(scope.profileHome,'plugin-data/own-agentmail/sends.sqlite3'), db =>
+    db.prepare(`SELECT inbox,payload,payload_sha256,state,message_id,thread_id,receipt,created FROM sends
+      WHERE action_id=? AND created>=? AND created<=?`).get(a.action_id,call.start,call.end));
+  if (row?.state !== 'sent_verified' || !row.message_id || !row.thread_id) return null;
+  const payload = parse(row.payload), receipt = parse(row.receipt);
+  const to = [...new Set(a.to.map(v => v.toLowerCase()))].sort();
+  if (!payload || !receipt || !to.length || to.includes(row.inbox) || !sameArray(payload.to,to) ||
+      payload.text !== a.text.replaceAll('\r\n','\n') || payload.subject !== a.subject ||
+      payload.reply_to_message_id !== (a.reply_to_message_id ?? undefined) || hash(row.payload) !== row.payload_sha256 ||
+      receipt.message_id !== row.message_id || receipt.thread_id !== row.thread_id || receipt.inbox_id !== row.inbox ||
+      !sameArray(receipt.to,to) || receipt.sent_verified !== true || receipt.payload_sha256 !== row.payload_sha256) return null;
+  const waiting = read(DatabaseSync, join(scope.profileHome,'runtime/agentmail-email/spool.sqlite3'), db => {
+    if (db.prepare("SELECT value FROM settings WHERE key='inbox'").get()?.value !== row.inbox) return false;
+    const received = db.prepare('SELECT 1 FROM messages WHERE thread_id=? AND id<>? AND received>=? LIMIT 1')
+      .get(row.thread_id,row.message_id,row.created);
+    return !received;
+  });
+  return waiting === true ? { to, text: payload.text } : null;
+}
+
+function awaitingEmail(content, email) {
+  if (!email || typeof content !== 'string' || /(?:```|^\s*>)/m.test(content)) return false;
+  // A sent FYI has no dependency. Require the outgoing request and a direct matching wait in the final.
+  if (!/(?:^|[.!?]\s+|\n)(?:please (?:reply|confirm|let me know|send|provide)|(?:can|could|will|would) you [^?\n]+\?)/im.test(email.text)) return false;
+  const text = content.toLowerCase().replaceAll('’',"'");
+  if (/(?:^|[.!?]\s+|\n)(?:i(?:'ve| have)? (?:sent (?:the|my|that) (?:email|request)|emailed them))(?:[,.]\s+| and )(?:and )?(?:i(?:'m| am) |am )?(?:now )?waiting (?:for|on) their (?:reply|answer|response)\b/i.test(text)) return true;
+  return email.to.some(addr => text.includes(addr) && (
+    text.includes("i'm waiting for " + addr + "'s reply") || text.includes("i am waiting for " + addr + "'s reply") ||
+    new RegExp("(?:^|[.!?]\\s+|\\n)(?:i(?:'ve| have)? (?:emailed|asked)|i (?:sent|wrote) (?:a request )?to) " +
+      addr.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') +
+      "(?:[.,]\\s*(?:(?:and )?i(?:'m| am) )?(?:now )?waiting (?:for|on) their (?:reply|answer|response)\\b)").test(text)));
+}
+
+export function readDecisionReceipt(DatabaseSync, scope, message, projectId) {
+  const statuses = [];
+  let pending = false;
+  if (!scope?.profile || !scope.profileHome || !message?.sender || !message.messageGuid ||
+      !['any;-;' + message.sender, 'iMessage;-;' + message.sender].includes(message.chatGuid) ||
+      message.spaceType !== 'dm' || message.direction !== 'inbound' || !projectId) return {statuses,pending};
+  const hermesHome = dirname(dirname(scope.profileHome));
+  const final = finalReply(DatabaseSync,scope,message,projectId,hermesHome);
+  const decision = decisionQuestion(final?.content);
+  const stamp = sourceStamp(DatabaseSync,scope,message);
+  if (stamp?.invalid) return {statuses,pending};
+  const turn = directTurn(DatabaseSync,scope,message,stamp);
+  if (decision && !stamp?.newer && !turn?.newerPrivateUser) {
+    if (final.delivered) statuses.push(decision);
+    else pending = true;
+  }
+  const mailCalls = turn?.calls.filter(c => c.name === 'agentmail_send') || [];
+  if (mailCalls.length === 1 && final?.content) {
+    if (awaitingEmail(final.content,mailOfTurn(DatabaseSync,scope,mailCalls[0]))) {
+      if (final.delivered) statuses.push('waiting_on_reply');
+      else pending = true;
+    }
+  }
+  return {statuses,pending};
+}
+
+export function readDecisionStatuses(...args) { return readDecisionReceipt(...args).statuses; }
+export function hasPendingDecisionReceipt(...args) { return readDecisionReceipt(...args).pending; }
