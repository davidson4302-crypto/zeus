+def _session_row_ended(store, key):
+    """True only when the key's session row EXISTS in its owning profile's state.db and is ended.
+    A brand-new turn has its id in the routing index before run_agent inserts the row, so a missing row
+    means "not written yet", not "closed" (otherwise a live turn is flagged as a ghost at age 0). The
+    routing store's own check treats a missing row as ended, which is right for routing but not here.
+    A truly stuck slot with no row still falls through to the idle / wall-clock rules."""
+    peek = getattr(store, 'peek_session_id', None)
+    sid = peek(key) if callable(peek) else None
+    if not (isinstance(sid, str) and sid):
+        return False
+    db_for_key = getattr(store, '_db_for_key', None)
+    if callable(db_for_key):
+        db = db_for_key(key)
+        row = db.get_session(sid) if db else None
+        return row is not None and row.get('end_reason') is not None
+    ended = getattr(store, '_is_session_ended_in_db', None)
+    return callable(ended) and ended(sid) is True
+
+
