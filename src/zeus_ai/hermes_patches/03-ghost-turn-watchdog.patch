+class Db:
+    def __init__(self, rows):
+        self.rows = rows
+
+    def get_session(self, sid):
+        return self.rows.get(sid)
+
+
+class KeyedStore(Store):
+    """Real-store shape: per-key owning DB; its own ended check calls a missing row ended."""
+    def __init__(self, rows):
+        super().__init__()
+        self.db, self.asked = Db(rows), []
+
+    def _db_for_key(self, key):
+        self.asked.append(key)
+        return self.db
+
+    def _is_session_ended_in_db(self, sid):
+        return self.db.get_session(sid) is None or self.db.get_session(sid).get('end_reason') is not None
+
+
+def keyed_runner(slots, rows):
+    r = runner(slots)
+    r.session_store = KeyedStore(rows)
+    return r
+
+
+def test_brand_new_turn_without_db_row_is_live():
+    # A just-admitted turn whose session row is not inserted yet must not read as session_closed.
+    key = 'agent:helper:email:dm:inbox:thread'
+    r = keyed_runner({key: (Agent(idle=0), 0)}, rows={})
+    live, ghosts = wa.classify_running(r)
+    assert live == [key] and ghosts == [] and r.session_store.asked == [key]
+
+
+def test_open_db_row_is_live_and_ended_row_is_ghost():
+    key = 'agent:helper:email:dm:inbox:thread'
+    live, ghosts = wa.classify_running(keyed_runner({key: (Agent(idle=3), 5)}, rows={'sid-' + key: {'end_reason': None}}))
+    assert live == [key] and not ghosts
+    live, ghosts = wa.classify_running(keyed_runner({key: (Agent(idle=3), 5)}, rows={'sid-' + key: {'end_reason': 'cli_close'}}))
+    assert live == [] and ghosts[0]['why'] == 'session_closed'
+
+
+def test_missing_row_stuck_slot_still_caught_by_idle_rule():
+    key = 'agent:helper:email:dm:inbox:thread'
+    live, ghosts = wa.classify_running(keyed_runner({key: (Agent(idle=1600), 1700)}, rows={}))
+    assert live == [] and ghosts[0]['why'] == 'idle_no_tool'
+
+
 def test_pending_sentinel_young_is_live_old_is_ghost():
     live, ghosts = wa.classify_running(runner({'agent:a:dm:1': (_AGENT_PENDING_SENTINEL, 30)}))
     assert live and not ghosts
