index 0000000000000000000000000000000000000000..5e2228862085b5ed72abb769867a39c88165a4a9
--- /dev/null
+++ b/tests/agent/test_background_review_separate_effort.py
@@ -0,0 +1,24 @@
+"""A separate review effort uses a cold digest, preserving the warm parent."""
+from types import SimpleNamespace
+from agent.background_review import _resolve_review_runtime, _fork_init_kwargs
+
+
+def parent():
+    return SimpleNamespace(provider='xai-oauth', model='grok-4.7', reasoning_config={'enabled':True,'effort':'medium'}, platform='cli', session_id='test-only', _current_main_runtime=lambda: {'api_mode':'codex_responses','base_url':'https://api.x.ai/v1','api_key':'test-only'})
+
+
+def test_explicit_separate_effort_uses_routed_branch():
+    agent=parent()
+    cfg={'provider':agent.provider,'model':agent.model,'reasoning_effort':'low','inherit_parent_reasoning':False}
+    rt=_resolve_review_runtime(agent,cfg)
+    assert rt['routed'] is True
+    kwargs=_fork_init_kwargs(agent,rt,True,1,cfg)
+    assert kwargs['reasoning_config']=={'enabled':True,'effort':'low'}
+    assert agent.reasoning_config=={'enabled':True,'effort':'medium'}
+    assert rt['model']==agent.model
+
+
+def test_default_same_model_preserves_warm_route():
+    agent=parent()
+    cfg={'provider':agent.provider,'model':agent.model,'reasoning_effort':'low'}
+    assert _resolve_review_runtime(agent,cfg)['routed'] is False
diff --git a/tests/cron/test_cron_default_reasoning.py b/tests/cron/test_cron_default_reasoning.py
new file mode 100644
index 0000000000000000000000000000000000000000..aafe8a631975e0099ec229f910ceab77e6e45bcc
--- /dev/null
+++ b/tests/cron/test_cron_default_reasoning.py
@@ -0,0 +1,27 @@
+"""Chat and cron can share a model with separate effort, without leaking to other profiles."""
+import pytest
+from cron.scheduler import _resolve_job_reasoning_config
+from hermes_cli.config import load_config_readonly
+from hermes_constants import resolve_reasoning_config
+
+CFG = {'model': {'default': 'grok-4.7'}, 'agent': {'reasoning_effort': 'medium', 'reasoning_overrides': {'gpt-6.1-terra': 'medium'}}, 'cron': {'model': 'grok-4.7', 'reasoning_effort': 'low'}}
+
+@pytest.mark.parametrize('job,model,expected', [({}, 'grok-4.7', 'low'), ({'reasoning_effort': 'high'}, 'grok-4.7', 'high'), ({}, 'gpt-6.1-terra', 'medium')])
+def test_cron_effort_precedence(job, model, expected):
+    assert _resolve_job_reasoning_config(job, CFG, model) == {'enabled': True, 'effort': expected}
+    assert resolve_reasoning_config(CFG, 'grok-4.7') == {'enabled': True, 'effort': 'medium'}
+
+def test_invalid_default_retains_agent_effort():
+    cfg = {**CFG, 'cron': {**CFG['cron'], 'reasoning_effort': 'turbo'}}
+    assert _resolve_job_reasoning_config({}, cfg, 'grok-4.7') == resolve_reasoning_config(cfg, 'grok-4.7')
+
+def test_profile_scoped_config_a_b_a(tmp_path, monkeypatch):
+    import json
+    homes = [tmp_path/'a', tmp_path/'b']
+    for home,cfg in zip(homes, [CFG, {**CFG, 'cron': {'model': 'grok-4.7'}}]):
+        home.mkdir()
+        (home/'config.yaml').write_text(json.dumps(cfg))
+    for home,expected in [(homes[0], 'low'), (homes[1], 'medium'), (homes[0], 'low')]:
+        monkeypatch.setenv('HERMES_HOME', str(home))
+        cfg = load_config_readonly()
+        assert _resolve_job_reasoning_config({}, cfg, 'grok-4.7') == {'enabled': True, 'effort': expected}
