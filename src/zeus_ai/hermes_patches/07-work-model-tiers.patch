diff --git a/tests/agent/test_work_model_tiers.py b/tests/agent/test_work_model_tiers.py
new file mode 100644
index 0000000000000000000000000000000000000000..a9aadf178c86154a985052d7854f8ccbe12e7092
--- /dev/null
+++ b/tests/agent/test_work_model_tiers.py
@@ -0,0 +1,92 @@
+"""agent.work_model_tiers: opt-in routing of turns to configured lookup / workflow / recovery routes.
+
+Only locally configured routes are possible; user text picks a category, never a model. Made-up config only.
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent import work_model_tiers as W
+
+TIERS = {
+    "lookup": {"model": "small-model", "provider": "prov", "reasoning_effort": "low"},
+    "workflow": {"model": "mid-model", "provider": "prov", "reasoning_effort": "medium",
+                 "fallback_providers": [{"provider": "other", "model": "backup"}]},
+    "recovery": {"model": "big-model", "provider": "prov", "reasoning_effort": "high"},
+}
+CFG = {"model": {"default": "main-model", "provider": "prov"}, "agent": {"work_model_tiers": TIERS}}
+
+
+@pytest.mark.parametrize("text,worker,expected", [
+    ("what is a haiku?", False, None),
+    ("what is a haiku?", True, "lookup"),
+    ("check my calendar for friday", False, "lookup"),
+    ("find the invoice, then email it to the vendor and update the sheet", False, "workflow"),
+    ("run the end-to-end migration workflow", False, "workflow"),
+    ("debug the crash loop in the gateway", False, "recovery"),
+    ("```\ndebug the crash loop\n```", True, "lookup"),       # fenced text never picks a route
+    (None, False, None),
+])
+def test_classify(text, worker, expected):
+    assert W.classify(text, worker=worker) == expected
+
+
+def test_no_tiers_configured_means_no_routing():
+    assert W.choose({"model": CFG["model"]}, "debug the crash loop") is None
+
+
+def test_choose_returns_only_configured_fields():
+    row = W.choose(CFG, "debug the crash loop in the gateway")
+    assert row == {"work_tier": "recovery", "model": "big-model", "provider": "prov", "reasoning_effort": "high"}
+
+
+def test_plain_chat_stays_on_the_main_route():
+    row = W.choose(CFG, "good morning")
+    assert row["work_tier"] == "main" and row["model"] == "main-model"
+
+
+def test_incomplete_tier_is_ignored():
+    cfg = {**CFG, "agent": {"work_model_tiers": {"lookup": {"model": "x"}}}}
+    assert W.choose(cfg, "check my calendar") is None
+
+
+def _state(messages, offset=0, calls=1):
+    return SimpleNamespace(messages=messages, current_turn_user_idx=offset, api_call_count=calls)
+
+
+def _agent(tier="lookup"):
+    a = SimpleNamespace(provider="prov", model="small-model", api_key="k", base_url="u", api_mode="m",
+                        _fallback_activated=False, reasoning_config=None)
+    W.bind(a, CFG, tier)
+    a.switch_model = lambda model, *args, **kw: setattr(a, "model", model)
+    return a
+
+
+def test_completed_tool_receipts_promote_to_workflow(monkeypatch):
+    import gateway.run_config_loaders as loaders
+    monkeypatch.setattr(loaders.GatewayConfigLoadersMixin, "_apply_fallback_chain_to_agent",
+                        staticmethod(lambda agent, chain: setattr(agent, "chain", chain)))
+    msgs = [{"role": "user", "content": "go"},
+            {"role": "assistant", "tool_calls": [{"id": "a", "function": {"name": "read"}},
+                                                 {"id": "b", "function": {"name": "search"}}]},
+            {"role": "tool", "tool_call_id": "a"}, {"role": "tool", "tool_call_id": "b"}]
+    agent = _agent()
+    W.advance_after_tools(agent, _state(msgs))
+    assert agent._work_model_tier == "workflow" and agent.model == "mid-model"
+    assert agent._work_tier_promoted is True and agent.chain == TIERS["workflow"]["fallback_providers"]
+
+
+def test_never_promotes_down_or_across_providers():
+    msgs = [{"role": "user"}, {"role": "assistant", "tool_calls": [{"id": "a", "function": {"name": "read"}}]},
+            {"role": "tool", "tool_call_id": "a"}]
+    agent = _agent("workflow")
+    W.advance_after_tools(agent, _state(msgs))
+    assert agent._work_model_tier == "workflow" and agent.model == "small-model"
+    agent = _agent("lookup")
+    agent.provider = "elsewhere"
+    W.advance_after_tools(agent, _state(msgs + [{"role": "assistant", "tool_calls": [
+        {"id": "b", "function": {"name": "x"}}, {"id": "c", "function": {"name": "y"}}]},
+        {"role": "tool", "tool_call_id": "b"}, {"role": "tool", "tool_call_id": "c"}]))
+    assert agent._work_model_tier == "lookup"
