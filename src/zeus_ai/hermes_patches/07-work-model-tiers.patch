diff --git a/agent/work_model_tiers.py b/agent/work_model_tiers.py
new file mode 100644
index 0000000000000000000000000000000000000000..2c4529764d065a257ab206a2b5db5165841a6c98
--- /dev/null
+++ b/agent/work_model_tiers.py
@@ -0,0 +1,192 @@
+"""Opt-in routing for ordinary agent turns and delegated worker goals.
+
+Only locally configured routes are possible. User text chooses a category,
+never a provider, model, budget, toolset, approval or account.
+"""
+from __future__ import annotations
+
+import logging
+import re
+
+log = logging.getLogger(__name__)
+_RECOVERY = re.compile(r"\b(debug(?:ging)?|troubleshoot(?:ing)?|root[ -]cause|deadlock|stack trace|crash loop|disaster recovery|incident recovery|(?:run|perform|start|execute|attempt) (?:a |the |our )?recovery|recover(?:y)? (?:from|after)|roll ?back.*(?:fail|corrupt)|(?:restore|recover|repair|diagnose|fix)\b.{0,80}\b(?:crash|failed|failing|broken|corrupt|incident|outage|regression|exception|pipeline|deployment|gateway|failure|backup))\b", re.I)
+_WORKFLOW = re.compile(r"\b(multi[ -](?:step|tool)|end[ -]to[ -]end|long[ -]running|cross[ -](?:tool|system)|(?:run|execute|carry out|coordinate|finish|complete|orchestrate|automate)\b.{0,60}\b(?:workflow|pipeline|migration|rollout))\b", re.I)
+_ACTION = re.compile(r"\b(find|search|check|look up|read|fetch|pull|retrieve|open|inspect|compare|cross[- ]reference|match|reconcile|update|write|draft|send|email|post|save|export|import|create|schedule|verify|summarize|compile|generate|build|test|sync|scan|collect|review)\b", re.I)
+_TOOL_ACTION = re.compile(r"\b(send|email|schedule|book|upload|download|sync|restore|install|deploy|rename|delete|remove|move|copy|append|touch|mkdir|run)\b|(?:\b(?:write|create|save|update|edit|draft|post|export|import)\b.{0,100}(?:\b(?:file|note|ticket|sheet|spreadsheet|email|message|event|document|folder|record|account|issue|contact|calendar|channel|inbox|database|list|task)\b|(?:/|\w+\.(?:md|txt|json|csv|py|pdf)\b)))", re.I)
+_LOOKUP = re.compile(r"\b(look ?up|search|fetch|retrieve|pull up|check|find|show me|list|scan|read|verify|browse|summarize|open)\b", re.I)
+_SOURCE = re.compile(r"\b(inbox|contacts?|calendar|hubspot|crm|slack|emails?|messages?|meeting|files?|spreadsheet|sheet|drive|database|repository|website|web|tickets?|logs?|account|forecast|weather|price|schedule|tasks?)\b", re.I)
+_DEFINE = re.compile(r"^\s*(?:what (?:is|are|does)|define|explain (?:what|the (?:term|meaning))|how does)\b", re.I)
+_CONNECT = re.compile(r"(?:\b(?:then|afterwards|next|finally|once|before|after|also|and)\b|[;\n])", re.I)
+_QUOTES = re.compile(r"```.*?```|(?:^|\n)\s*>[^\n]*", re.S)
+_ROUTE_FIELDS = ('model','provider','base_url','api_mode','reasoning_effort','fallback_providers')
+
+def classify(text, *, worker=False):
+    """Classify an instruction, ignoring fenced code and quoted records."""
+    if not isinstance(text, str):
+        return 'lookup' if worker else None
+    s = _QUOTES.sub(' ', text[:10000]).strip()
+    if not s:
+        return 'lookup' if worker else None
+    if _DEFINE.search(s) and not _CONNECT.search(s) and not _SOURCE.search(s):
+        return 'lookup' if worker else None
+    if _RECOVERY.search(s):
+        return 'recovery'
+    if _WORKFLOW.search(s) or (_CONNECT.search(s) and len(set(m.group().lower() for m in _ACTION.finditer(s))) >= 2):
+        return 'workflow'
+    if _TOOL_ACTION.search(s) or _LOOKUP.search(s) or (_SOURCE.search(s) and ('?' in s or re.match(r"(?:what|when|where|how many|which|who)\b", s, re.I))):
+        return 'lookup'
+    return 'lookup' if worker else None
+
+def configured(config=None):
+    """True when the active profile (or ``config``) sets ``agent.work_model_tiers``."""
+    if config is None:
+        from hermes_cli.config import load_config_readonly
+        config = load_config_readonly()
+    return isinstance(((config or {}).get('agent') or {}).get('work_model_tiers'), dict)
+
+def choose(config, text, *, worker=False):
+    tiers = ((config or {}).get('agent') or {}).get('work_model_tiers')
+    if not isinstance(tiers, dict):
+        return None
+    name = classify(text, worker=worker)
+    if name is None and not worker:
+        main = config.get('model') or {}
+        if not isinstance(main,dict) or not main.get('default') or not main.get('provider'):
+            return None
+        return {'work_tier':'main', 'model':main['default'], 'provider':main['provider'],
+                'reasoning_effort':(config.get('agent') or {}).get('reasoning_effort','medium'),
+                'base_url':main.get('base_url'), 'api_mode':main.get('api_mode'),
+                'fallback_providers':config.get('fallback_providers') or []}
+    row = tiers.get(name)
+    if not isinstance(row, dict) or not all(row.get(k) for k in ('model','provider','reasoning_effort')):
+        return None
+    return {'work_tier':name, **{k:row[k] for k in _ROUTE_FIELDS if k in row}}
+
+def resolve(config, row):
+    """Use the ordinary resolver and its own auth-fallback policy for this tier."""
+    from hermes_cli.runtime_provider import resolve_runtime_with_fallback
+    from hermes_cli.fallback_config import pre_agent_fallback_notice
+    from hermes_constants import parse_reasoning_effort
+    chain = list(row.get('fallback_providers') or [])
+    runtime, backup = resolve_runtime_with_fallback(
+        {**config, 'fallback_providers':chain}, requested=row['provider'],
+        target_model=row['model'], explicit_base_url=row.get('base_url'))
+    current = backup or row
+    if current.get('api_mode'):
+        runtime = {**runtime, 'api_mode':current['api_mode']}
+    notice = None
+    if backup:
+        notice = pre_agent_fallback_notice(row['provider'],row['model'],runtime.get('provider'),backup['model'])
+        chain = chain[chain.index(backup)+1:] if backup in chain else [fb for fb in chain if (fb.get('provider'),fb.get('model')) != (backup.get('provider'),backup.get('model'))]
+    log.info('Work tier %s resolved %s (%s)', row['work_tier'], current['model'], current.get('reasoning_effort'))
+    return current['model'],runtime,parse_reasoning_effort(current.get('reasoning_effort')),chain,notice
+
+def advance_after_tools(agent, state):
+    # Completed tool receipts alone advance the next model decision. Never invoke a tool,
+    # rewrite the message list, retry a completed call or change its authority.
+    current = getattr(agent,'_work_model_tier',None)
+    if current not in ('main','lookup','workflow') or not state.api_call_count:
+        return
+    offset = state.current_turn_user_idx
+    if not isinstance(offset,int) or offset < 0:
+        return
+    requested = {}
+    completed = set()
+    errors = set()
+    for msg in state.messages[offset+1:]:
+        if not isinstance(msg,dict):
+            continue
+        if msg.get('role') == 'assistant':
+            for call in msg.get('tool_calls') or []:
+                if isinstance(call,dict) and call.get('id'):
+                    requested[call['id']] = (call.get('function') or {}).get('name','')
+        elif msg.get('role') == 'tool' and msg.get('tool_call_id') in requested:
+            ident = msg['tool_call_id']
+            completed.add(ident)
+            if msg.get('is_error') is True or msg.get('status') == 'error':
+                errors.add(ident)
+    if not completed:
+        return
+    kinds = {requested[i] for i in completed}
+    target = 'recovery' if len(errors) >= 2 else 'workflow' if len(kinds) >= 2 or len(completed) >= 3 else 'lookup'
+    ranks = {'main':0,'lookup':1,'workflow':2,'recovery':3}
+    if ranks[target] <= ranks[current] or getattr(agent,'_fallback_activated',False):
+        return
+    cfg = getattr(agent,'_work_tier_config',None) or {}
+    route = ((cfg.get('agent') or {}).get('work_model_tiers') or {}).get(target)
+    if not isinstance(route,dict) or agent.provider != route.get('provider'):
+        return
+    # A credential failure can occur after a tool has already succeeded. Keep the existing
+    # route on a failed rebind; this helper never drives a retry.
+    try:
+        from hermes_constants import parse_reasoning_effort
+        from gateway.run_config_loaders import GatewayConfigLoadersMixin
+        if agent.model != route['model']:
+            agent.switch_model(route['model'],agent.provider,api_key=agent.api_key,
+                               base_url=agent.base_url,api_mode=agent.api_mode,
+                               capabilities=getattr(agent,'runtime_capabilities',None))
+        agent.reasoning_config = parse_reasoning_effort(route['reasoning_effort'])
+        GatewayConfigLoadersMixin._apply_fallback_chain_to_agent(agent, route.get('fallback_providers'))
+        agent._work_model_tier = target
+        agent._work_tier_promoted = True
+        log.info('Next decision uses work tier %s after %s completed tool calls',target,len(completed))
+    except (ValueError, KeyError, RuntimeError, OSError) as exc:
+        log.warning('Could not promote work tier after tools: %s',type(exc).__name__)
+
+def bind(agent, config, tier):
+    agent._work_model_tier = tier
+    agent._work_tier_config = config if tier else None
+    agent._work_tier_promoted = False
+
+def gateway_choice(runner, ctx):
+    cfg = ctx.user_config or {}
+    text = getattr(ctx,'title_user_message',None) or getattr(ctx,'persist_user_message',None) or ctx.message
+    row = choose(cfg,text)
+    if row is None:
+        return None
+    # Honor explicit session and channel model/reasoning choices.
+    key = ctx.session_key
+    if key:
+        runner._rehydrate_session_model_override(key)
+        state = runner._peek_session_state(key)
+        conv = getattr(state,'conversation',None)
+        if getattr(conv,'model_override',None) or getattr(conv,'reasoning_override',None) is not None:
+            return None
+    from gateway.run import _get_channel_override
+    source = ctx.source
+    ch = _get_channel_override(getattr(runner,'config',None),source.platform,str(source.chat_id or ''),
+                               thread_id=getattr(source,'thread_id',None),parent_id=getattr(source,'parent_chat_id',None))
+    if ch and (getattr(ch,'model',None) or getattr(ch,'provider',None) or getattr(ch,'reasoning_effort',None)):
+        return None
+    return row
+
+def parent_config(parent, goal=None, *, resolve_route=False):
+    from hermes_cli.config import load_config_readonly
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from tools.delegate_tool import _parent_live_home
+    home = _parent_live_home(parent)
+    token = set_hermes_home_override(home) if home is not None else None
+    try:
+        cfg = load_config_readonly()
+        if resolve_route:
+            route = choose(cfg, goal, worker=True)
+            return (route, resolve(cfg,route)) if route else (None, None)
+        return cfg
+    finally:
+        if token is not None:
+            reset_hermes_home_override(token)
+
+def delegate_choice(parent, goal):
+    return choose(parent_config(parent), goal, worker=True)
+
+def cli_choice(config, cli, text):
+    main = config.get('model') or {}
+    if not isinstance(main,dict) or not ((config.get('agent') or {}).get('work_model_tiers')):
+        return None
+    if cli.model != main.get('default') or cli.provider != main.get('provider'):
+        return None
+    # Keep a consciously selected effort and an explicitly resumed conversation route.
+    from hermes_constants import resolve_reasoning_config
+    if getattr(cli,'_resumed',False) or cli.reasoning_config != resolve_reasoning_config(config, cli.model):
+        return None
+    return choose(config,text)
